<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
        <add key="DemoPaymentsEnabled" value="true"/>
    </appSettings>
	<connectionStrings>
		<add name="CRMS"
             connectionString="Server=localhost;Database=CRMS;Integrated Security=True;TrustServerCertificate=True;"
             providerName="Microsoft.Data.SqlClient"/>
	</connectionStrings>
</configuration>
