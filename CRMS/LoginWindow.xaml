<Window x:Class="CRMS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRMS - Đăng nhập"
        Height="580"
        Width="460"
        MinHeight="520"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">

    <Border Margin="20"
            Background="White"
            CornerRadius="14"
            Padding="30">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Logo -->
                <TextBlock Text="CRMS"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,5"/>

                <TextBlock Text="Đăng nhập vào tài khoản"
                           FontSize="14"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Email -->
                <TextBlock Text="Email"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox Height="42"
                         Padding="12,8"
                         FontSize="14"
                         Text="{Binding Email,
                         UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->
                <TextBlock Text="Mật khẩu"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,20,0,8"/>

                <PasswordBox x:Name="PasswordInput"
                             Height="42"
                             Padding="12,8"
                             FontSize="14"/>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,12,0,12"
                           MinHeight="24"/>

                <!-- LOGIN BUTTON -->
                <Button Content="Đăng nhập"
                        Height="45"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsEnabled="{Binding IsNotLoading}"
                        Click="Login_Click"/>

                <!-- REGISTER BUTTON -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,22,0,0">

                    <TextBlock Text="Chưa có tài khoản?"
                               FontSize="13"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>

                    <Button Content="Đăng ký ngay"
                            Background="Transparent"
                            Foreground="#2563EB"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Padding="8,5"
                            Click="OpenRegister_Click"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>
    </Border>
</Window>
