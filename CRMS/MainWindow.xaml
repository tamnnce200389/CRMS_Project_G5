<Window x:Class="CRMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CRMS.ViewModels"
        xmlns:shared="clr-namespace:CRMS.Views.Shared"
        Title="CRMS - Car Rental Management System"
        Width="1400"
        Height="860"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible"/>
    </Window.Resources>

    <!-- MAIN LAYOUT -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ADMIN SIDEBAR -->
        <shared:AdminSidebar
            Grid.Column="0"
            Visibility="{Binding IsAdmin,
                Converter={StaticResource BoolVisible}}"/>

        <!-- STAFF SIDEBAR -->
        <shared:StaffSidebar
            Grid.Column="0"
            Visibility="{Binding IsStaff,
                Converter={StaticResource BoolVisible}}"/>

        <!-- PAGE CONTENT -->
        <Grid Grid.Column="1"
              Background="{StaticResource PageBackground}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- MANAGEMENT HEADER -->
            <Border Grid.Row="0"
                    Height="72"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1"
                    Padding="28,0"
                    Visibility="{Binding IsManagement,
                        Converter={StaticResource BoolVisible}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BREADCRUMB -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="CRMS"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="14"/>

                        <TextBlock Text="/"
                                   Foreground="{StaticResource Line}"
                                   FontSize="14"
                                   Margin="12,0"/>

                        <TextBlock Text="{Binding CurrentPage.Title}"
                                   Foreground="{StaticResource Ink}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- ROLE AND LOGOUT -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- ADMIN BADGE -->
                        <Border Background="{StaticResource PrimarySoft}"
                                CornerRadius="7"
                                Padding="13,8"
                                Margin="0,0,12,0"
                                Visibility="{Binding IsAdmin,
                                    Converter={StaticResource BoolVisible}}">

                            <TextBlock Text="ADMIN"
                                       Foreground="{StaticResource PrimaryPressed}"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Border>

                        <!-- STAFF BADGE -->
                        <Border Background="{StaticResource PrimarySoft}"
                                CornerRadius="7"
                                Padding="13,8"
                                Margin="0,0,12,0"
                                Visibility="{Binding IsStaff,
                                    Converter={StaticResource BoolVisible}}">

                            <TextBlock Text="STAFF"
                                       Foreground="{StaticResource PrimaryHover}"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Border>
                        
                        <!-- PROFILE -->
                        <Button Content="Hồ sơ cá nhân"
                                Height="36"
                                Padding="16,6"
                                Margin="0,0,8,0"
                                Background="{StaticResource Surface}"
                                Foreground="{StaticResource Ink}"
                                BorderBrush="{StaticResource Line}"
                                Cursor="Hand"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Profile"
                                Visibility="{Binding IsLoggedIn,
                                Converter={StaticResource BoolVisible}}"/>

                        <!-- LOGOUT -->
                        <Button Content="Đăng xuất"
                                Height="36"
                                Padding="16,6"
                                Background="{StaticResource Surface}"
                                Foreground="{StaticResource Ink}"
                                BorderBrush="{StaticResource Line}"
                                Cursor="Hand"
                                Click="Logout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT FRAME -->
            <Frame Grid.Row="1"
                   Content="{Binding CurrentPage}"
                   NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal"
                   Background="{StaticResource PageBackground}"/>

        </Grid>
    </Grid>
</Window>
