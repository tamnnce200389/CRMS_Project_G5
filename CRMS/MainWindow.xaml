<Window x:Class="CRMS.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:CRMS.ViewModels" Title="CRMS • Quản lý cho thuê xe" Width="1360" Height="860" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#122035">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="26,32,24,30">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#2563EB" CornerRadius="10" Width="38" Height="38">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="CRMS" Foreground="White" FontSize="25" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="QUẢN LÝ CHO THUÊ XE" Foreground="#71839F" FontSize="10" Margin="0,16,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Hệ thống" Foreground="#71839F" FontSize="10" FontWeight="SemiBold" Margin="28,8,0,13" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding IsDashboard, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" />
                            <TextBlock Text="Tổng quan" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding IsVehicles, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Vehicles">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" />
                            <TextBlock Text="Đội xe" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding IsBookings, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Bookings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" />
                            <TextBlock Text="Đơn thuê" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding IsDrivers, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Drivers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" />
                            <TextBlock Text="Tài xế" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding IsReports, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="30" VerticalAlignment="Center" />
                            <TextBlock Text="Báo cáo" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="#29394F" BorderThickness="0,1,0,0" Padding="24,22">
                    <StackPanel>
                        <TextBlock Text="Quản lý thuê xe" Foreground="#CFD9E8" FontWeight="SemiBold" />
                        <TextBlock Text="Tập trung. Kết nối. Chủ động." FontSize="10" Foreground="#71839F" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="32,0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right" Background="#F1F5FB" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
                        <TextBlock Text="HỆ THỐNG QUẢN LÝ THUÊ XE" Foreground="#60718D" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Hệ thống" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="/" Foreground="#C1CAD7" Margin="14,0" />
                        <TextBlock Text="{Binding CurrentPage.Title}" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Frame Grid.Row="1" Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" />
        </Grid>
    </Grid>
</Window>