<Window x:Class="CRMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CRMS.ViewModels"
        xmlns:shared="clr-namespace:CRMS.Views.Shared"
        xmlns:services="clr-namespace:CRMS.Services"
        Title="CRMS - Car Rental Management System"
        Width="1400"
        Height="860"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        FontFamily="Segoe UI"
        FontSize="14"
        Language="vi-VN"
        Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible"/>
        <Style x:Key="ProfileMenuButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource CustomerInk}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ProfileSurface" Background="{TemplateBinding Background}" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1" CornerRadius="28" Padding="6,5,14,5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ProfileSurface" Property="Background" Value="{StaticResource CustomerBackground}"/><Setter TargetName="ProfileSurface" Property="BorderBrush" Value="{StaticResource CustomerMuted}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ProfileSurface" Property="BorderBrush" Value="{StaticResource CustomerInk}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ProfileSurface" Property="Opacity" Value="0.8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AccountMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource CustomerInk}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"/>
                        <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource CustomerSoft}"/><Setter Property="Foreground" Value="{StaticResource CustomerInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource CustomerSoft}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource CustomerSoft}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AccountMenuIcon" TargetType="Path">
            <Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="Stroke" Value="{StaticResource CustomerMuted}"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
    </Window.Resources>

    <!-- MAIN LAYOUT -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ADMIN SIDEBAR -->
        <shared:AdminSidebar
            Grid.Column="0"
            Visibility="{Binding IsAdmin,
                Converter={StaticResource BoolVisible}}"/>

        <!-- STAFF SIDEBAR -->
        <shared:StaffSidebar
            Grid.Column="0"
            Visibility="{Binding IsStaff,
                Converter={StaticResource BoolVisible}}"/>

        <!-- PAGE CONTENT -->
        <Grid Grid.Column="1"
              Background="{StaticResource PageBackground}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CustomerLine}" BorderThickness="0,0,0,1" Visibility="{Binding IsCustomer, Converter={StaticResource BoolVisible}}" Padding="36,0">
                    <Grid Height="84" MaxWidth="1320">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource CustomerInk}" CornerRadius="14" Width="44" Height="44">
                                <Path Data="M3,17 L3,10 L6,5 L18,5 L21,10 L21,17 Z M3,10 L21,10 M6,14 L8,14 M16,14 L18,14 M6,17 L6,20 M18,17 L18,20" Stroke="{StaticResource CustomerAccent}" StrokeThickness="1.7" Width="25" Height="25" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0"><TextBlock Text="CRMS" FontSize="25" FontWeight="Bold" Foreground="{StaticResource CustomerInk}"/><TextBlock Text="Mở lối hành trình" Foreground="{StaticResource CustomerMuted}" FontSize="11"/></StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Khám phá xe" Style="{StaticResource GhostButton}" Foreground="{StaticResource CustomerInk}" Command="{Binding NavigateCommand}" CommandParameter="Home" Margin="0,0,20,0"/>
                            <Border Width="1" Height="28" Background="{StaticResource CustomerLine}" Margin="0,0,22,0"/>
                            <Button x:Name="AccountButton" Style="{StaticResource ProfileMenuButton}" Click="Account_Click" AutomationProperties.Name="Mở menu cá nhân" ToolTip="{Binding FullName, Source={x:Static services:CurrentUserService.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CustomerSoft}" Margin="0,0,10,0"><TextBlock Text="{Binding AvatarInitials, Source={x:Static services:CurrentUserService.Instance}}" Foreground="{StaticResource CustomerInk}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{Binding FullName, Source={x:Static services:CurrentUserService.Instance}}" MaxWidth="170" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Path Data="M1,1 L5,5 L9,1" Stroke="{StaticResource CustomerMuted}" StrokeThickness="1.6" Width="9" Height="5" Stretch="Uniform" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="AccountMenu" Width="272" Placement="Bottom" VerticalOffset="8"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ContextMenu.Template><ControlTemplate TargetType="ContextMenu">
                                            <Border Background="White" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1" CornerRadius="16" Padding="8">
                                                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                                    <StackPanel Margin="14,10,14,14">
                                                        <TextBlock Text="Đang đăng nhập" Foreground="{StaticResource CustomerMuted}" FontSize="11"/>
                                                        <TextBlock Text="{Binding FullName, Source={x:Static services:CurrentUserService.Instance}}" Foreground="{StaticResource CustomerInk}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                                                        <TextBlock Text="Quản trị viên" Foreground="{StaticResource CustomerMuted}" FontSize="11" Margin="0,5,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisible}}"/>
                                                        <TextBlock Text="Nhân viên" Foreground="{StaticResource CustomerMuted}" FontSize="11" Margin="0,5,0,0" Visibility="{Binding IsStaff, Converter={StaticResource BoolVisible}}"/>
                                                    </StackPanel>
                                                    <Border Height="1" Background="{StaticResource Line}" Margin="6,0,6,6"/>
                                                    <StackPanel IsItemsHost="True"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate></ContextMenu.Template>
                                        <MenuItem Visibility="{Binding IsCustomer, Converter={StaticResource BoolVisible}}" Header="Chuyến thuê của tôi" Style="{StaticResource AccountMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="MyBookings" IsChecked="{Binding IsCustomerBookings, Mode=OneWay}">
                                            <MenuItem.Icon><Path Style="{StaticResource AccountMenuIcon}" Data="M4,5 L20,5 L20,21 L4,21 Z M4,10 L20,10 M8,2 L8,7 M16,2 L16,7 M8,14 L11,14 M8,17 L16,17"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Visibility="{Binding IsCustomer, Converter={StaticResource BoolVisible}}" Header="Thanh toán" Style="{StaticResource AccountMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="PaymentSummary" IsChecked="{Binding IsCustomerPayments, Mode=OneWay}">
                                            <MenuItem.Icon><Path Style="{StaticResource AccountMenuIcon}" Data="M3,5 L21,5 L21,19 L3,19 Z M3,10 L21,10 M7,15 L11,15"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Hồ sơ cá nhân" Style="{StaticResource AccountMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="Profile" IsChecked="{Binding IsCustomerProfile, Mode=OneWay}">
                                            <MenuItem.Icon><Path Style="{StaticResource AccountMenuIcon}" Data="M12,3 A4,4 0 1 1 12,11 A4,4 0 1 1 12,3 M4,22 L4,19 C4,12 20,12 20,19 L20,22"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Margin="6,6" Background="{StaticResource Line}"/>
                                        <MenuItem Header="Đăng xuất" Style="{StaticResource AccountMenuItem}" Foreground="{StaticResource Danger}" Click="Logout_Click">
                                            <MenuItem.Icon><Path Style="{StaticResource AccountMenuIcon}" Stroke="{StaticResource Danger}" Data="M10,3 L3,3 L3,21 L10,21 M8,12 L21,12 M16,7 L21,12 L16,17"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>
            </Border>

            <!-- MANAGEMENT HEADER -->
            <Border Grid.Row="0"
                    Height="72"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource CustomerLine}"
                    BorderThickness="0,0,0,1"
                    Padding="28,0"
                    Visibility="{Binding IsManagement,
                        Converter={StaticResource BoolVisible}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BREADCRUMB -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="CRMS"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="14"/>

                        <TextBlock Text="/"
                                   Foreground="{StaticResource CustomerLine}"
                                   FontSize="14"
                                   Margin="12,0"/>

                        <TextBlock Text="{Binding CurrentPage.Title}"
                                   Foreground="{StaticResource CustomerInk}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button x:Name="ManagementAccountButton" Grid.Column="1"
                            Style="{StaticResource ProfileMenuButton}" VerticalAlignment="Center"
                            Click="Account_Click" ContextMenu="{Binding ContextMenu, ElementName=AccountButton}"
                            AutomationProperties.Name="Mở menu cá nhân"
                            ToolTip="{Binding FullName, Source={x:Static services:CurrentUserService.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CustomerSoft}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding AvatarInitials, Source={x:Static services:CurrentUserService.Instance}}" Foreground="{StaticResource CustomerInk}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding FullName, Source={x:Static services:CurrentUserService.Instance}}" MaxWidth="170" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CustomerInk}" VerticalAlignment="Center"/>
                            <Path Data="M1,1 L5,5 L9,1" Stroke="{StaticResource CustomerMuted}" StrokeThickness="1.6" Width="9" Height="5" Stretch="Uniform" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT FRAME -->
            <Frame Grid.Row="1"
                   Content="{Binding CurrentPage}"
                   NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal"
                   Background="{StaticResource PageBackground}"/>

        </Grid>
    </Grid>
</Window>
