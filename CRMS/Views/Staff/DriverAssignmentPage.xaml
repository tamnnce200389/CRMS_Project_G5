<Page x:Class="CRMS.Views.Staff.DriverAssignmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Phân công tài xế" Background="#F4F8F6">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Phân công tài xế" FontSize="27" FontWeight="Bold" Foreground="#172B24"/>
            <TextBlock Text="Chọn Booking thuê có tài xế và tài xế phù hợp. Hệ thống kiểm tra lịch trùng trước khi lưu."
                       Margin="0,8,0,16" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Làm mới" Click="Refresh_Click" Padding="16,8" Margin="0,0,12,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#475569"/>
        </DockPanel>
        <DataGrid x:Name="BookingsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã Booking" Binding="{Binding BookingCode}" Width="Auto" MinWidth="140"/>
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="Auto" MinWidth="150"/>
                <DataGridTextColumn Header="Xe" Binding="{Binding VehicleName}" Width="Auto" MinWidth="150"/>
                <DataGridTextColumn Header="Biển số" Binding="{Binding LicensePlate}" Width="Auto" MinWidth="120"/>
                <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="Auto" MinWidth="145"/>
                <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="Auto" MinWidth="145"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding BookingStatus}" Width="Auto" MinWidth="125"/>
                <DataGridTextColumn Header="Tài xế hiện tại" Binding="{Binding DriverName}" Width="*" MinWidth="160"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Background="White" Padding="14" Margin="0,12,0,0" CornerRadius="8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Tài xế:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="DriversCombo" Width="260" DisplayMemberPath="FullName"
                          SelectedValuePath="DriverId" Margin="0,0,14,0"/>
                <Button Content="Phân công tài xế" Click="Assign_Click" Padding="18,9"
                        Background="#16A34A" Foreground="White" BorderThickness="0"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>