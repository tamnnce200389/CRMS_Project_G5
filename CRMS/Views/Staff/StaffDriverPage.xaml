<Page x:Class="CRMS.Views.Staff.StaffDriverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:CRMS.ViewModels"
      Title="Tra cứu tài xế"
      Background="#F4F8F6"
      FontFamily="Segoe UI">

    <Page.DataContext>
        <vm:DriverViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="28">

            <!-- HEADER -->
            <TextBlock Text="Danh sách tài xế"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#153D34"/>

            <TextBlock Text="Tra cứu tài xế phục vụ việc phân công cho các đơn thuê có tài xế."
                       Foreground="#64748B"
                       Margin="0,8,0,24"
                       TextWrapping="Wrap"/>

            <!-- SUMMARY -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#DCEAE5"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <TextBlock Text="TỔNG SỐ TÀI XẾ"
                                   Foreground="#64748B"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding TotalDrivers}"
                                   Foreground="#153D34"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#DCEAE5"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22">

                    <StackPanel>
                        <TextBlock Text="ĐANG HOẠT ĐỘNG"
                                   Foreground="#64748B"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding ActiveDrivers}"
                                   Foreground="#059669"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TABLE -->
            <Border Background="White"
                    BorderBrush="#DCEAE5"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18">

                <StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Thông tin tài xế"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#153D34"/>

                        <Button Grid.Column="1"
                                Content="Làm mới"
                                Width="105"
                                Height="38"
                                Background="#16A085"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding RefreshCommand}"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Drivers}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeight="44"
                              ColumnHeaderHeight="42"
                              MinHeight="350"
                              BorderThickness="0"
                              Background="White"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="MÃ"
                                                Binding="{Binding DriverId}"
                                                Width="80"/>

                            <DataGridTextColumn Header="HỌ VÀ TÊN"
                                                Binding="{Binding FullName}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="SỐ ĐIỆN THOẠI"
                                                Binding="{Binding Phone}"
                                                Width="*"/>

                            <DataGridTextColumn Header="SỐ GIẤY PHÉP"
                                                Binding="{Binding LicenseNumber}"
                                                Width="*"/>

                            <DataGridCheckBoxColumn Header="HOẠT ĐỘNG"
                                                    Binding="{Binding IsActive}"
                                                    IsReadOnly="True"
                                                    Width="110"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Nhân viên chỉ được xem thông tin tài xế. Chức năng phân công tài xế sẽ được tích hợp riêng."
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
