<Page x:Class="CRMS.Views.Staff.ReturnPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Nhận xe trả"
      Background="{StaticResource PageBackground}">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="Nhận xe trả"
                       FontSize="28"
                       FontWeight="Bold"/>
            <TextBlock Text="Chức năng tiếp nhận và kiểm tra xe trả đang được tích hợp."
                       Foreground="{StaticResource MutedReadable}"
                       TextWrapping="Wrap"
                       Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Page>
