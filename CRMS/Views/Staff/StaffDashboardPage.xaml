<Page x:Class="CRMS.Views.Admin.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard quản trị"
      Background="#F5F7FC"
      FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="AdminCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="AdminActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30,27,30,36">

            <!-- HEADER -->
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Dashboard quản trị"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#142642"/>

                    <TextBlock Text="Trung tâm điều hành và quản lý hệ thống cho thuê xe CRMS."
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#DBEAFE"
                        CornerRadius="8"
                        Padding="14,9"
                        VerticalAlignment="Center">

                    <TextBlock Text="ADMIN PANEL"
                               Foreground="#1D4ED8"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- HERO -->
            <Border CornerRadius="18"
                    Padding="30"
                    Margin="0,0,0,27">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#173C75" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CAR RENTAL MANAGEMENT SYSTEM"
                                   Foreground="#BDD5FF"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Quản lý thông minh, vận hành hiệu quả."
                                   Foreground="White"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,10"/>

                        <TextBlock Text="Quản lý đội xe, đơn thuê, tài xế và truy cập các báo cáo kinh doanh từ một giao diện tập trung."
                                   Foreground="#DAE9FF"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   MaxWidth="680"
                                   Margin="0,0,0,20"/>

                        <Button Content="Xem báo cáo →"
                                HorizontalAlignment="Left"
                                Background="White"
                                Foreground="#1D4ED8"
                                BorderThickness="0"
                                Padding="21,12"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Command="{Binding DataContext.NavigateCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Reports"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="115"
                            Height="115"
                            CornerRadius="58"
                            Background="#3973CD"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <TextBlock Text="&#xE80F;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="55"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- MANAGEMENT MODULES -->
            <TextBlock Text="Quản lý hệ thống"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#142642"
                       Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- VEHICLES -->
                <Border Grid.Column="0"
                        Style="{StaticResource AdminCard}"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <Border Width="48"
                                Height="48"
                                CornerRadius="11"
                                Background="#E6F0FF"
                                HorizontalAlignment="Left">

                            <TextBlock Text="&#xE804;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#2563EB"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Quản lý phương tiện"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#142642"
                                   Margin="0,16,0,9"/>

                        <TextBlock Text="Theo dõi danh sách xe, thông số và trạng thái hoạt động."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   MinHeight="62"/>

                        <Button Content="Quản lý xe →"
                                Style="{StaticResource AdminActionButton}"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Command="{Binding DataContext.NavigateCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Vehicles"/>
                    </StackPanel>
                </Border>

                <!-- BOOKINGS -->
                <Border Grid.Column="1"
                        Style="{StaticResource AdminCard}"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <Border Width="48"
                                Height="48"
                                CornerRadius="11"
                                Background="#E6F7EE"
                                HorizontalAlignment="Left">

                            <TextBlock Text="&#xE8A1;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#16A34A"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Quản lý đơn thuê"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#142642"
                                   Margin="0,16,0,9"/>

                        <TextBlock Text="Theo dõi quy trình đặt xe và trạng thái xử lý đơn thuê."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   MinHeight="62"/>

                        <Button Content="Xem đơn thuê →"
                                Style="{StaticResource AdminActionButton}"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Command="{Binding DataContext.NavigateCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Bookings"/>
                    </StackPanel>
                </Border>

                <!-- DRIVERS -->
                <Border Grid.Column="2"
                        Style="{StaticResource AdminCard}">

                    <StackPanel>
                        <Border Width="48"
                                Height="48"
                                CornerRadius="11"
                                Background="#FFF1E0"
                                HorizontalAlignment="Left">

                            <TextBlock Text="&#xE716;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#EA8B25"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Quản lý tài xế"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#142642"
                                   Margin="0,16,0,9"/>

                        <TextBlock Text="Quản lý thông tin và trạng thái hoạt động của tài xế."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   MinHeight="62"/>

                        <Button Content="Quản lý tài xế →"
                                Style="{StaticResource AdminActionButton}"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Command="{Binding DataContext.NavigateCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Drivers"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- REPORT AREA -->
            <TextBlock Text="Báo cáo và phân tích"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#142642"
                       Margin="0,0,0,16"/>

            <Border Style="{StaticResource AdminCard}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#E8EDFF"
                            Width="64"
                            Height="64"
                            CornerRadius="13"
                            Margin="0,0,20,0">

                        <TextBlock Text="&#xE9D9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="#4F46E5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Revenue Reports"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#142642"/>

                        <TextBlock Text="Truy cập báo cáo doanh thu và các chỉ số kinh doanh của hệ thống."
                                   Foreground="#64748B"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,8,10,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Mở báo cáo →"
                            Style="{StaticResource AdminActionButton}"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.NavigateCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Reports"/>
                </Grid>
            </Border>

            <TextBlock Text="Các số liệu tổng hợp sẽ được kết nối trực tiếp với dữ liệu Booking và Payment trong quá trình tích hợp Dashboard."
                       FontSize="12"
                       Foreground="#94A3B8"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Page>
