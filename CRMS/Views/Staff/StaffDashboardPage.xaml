<Page x:Class="CRMS.Views.Staff.StaffDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tổng quan nhân viên"
      Background="{StaticResource PageBackground}"
      FontFamily="Segoe UI">

    <Page.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="StaffCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="{StaticResource ShadowColor}"/>
                </Setter.Value>
            </Setter></Style>

        <Style BasedOn="{StaticResource {x:Type Button}}" x:Key="StaffActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StaffKpiCard"
               TargetType="Border">
            <Setter Property="Width" Value="205"/>
            <Setter Property="MinHeight" Value="112"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30,27,30,36">

            <!-- HEADER -->

            <TextBlock Text="Tổng quan nhân viên"
                       FontSize="29"
                       FontWeight="Bold"
                       Foreground="{StaticResource Ink}"/>

            <TextBlock
                Text="Không gian làm việc dành cho nhân viên vận hành CRMS."
                FontSize="14"
                Foreground="{StaticResource MutedReadable}"
                Margin="0,8,0,25"/>

            <!-- STAFF BANNER -->

            <Border CornerRadius="18"
                    Padding="30"
                    Margin="0,0,0,28">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryPressedColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel>

                    <TextBlock Text="STAFF WORKSPACE"
                               Foreground="{StaticResource HeroText}"
                               FontWeight="Bold"
                               FontSize="12"/>

                    <TextBlock Text="Sẵn sàng cho ca làm việc!"
                               Foreground="{StaticResource Surface}"
                               FontSize="29"
                               FontWeight="Bold"
                               Margin="0,12,0,10"/>

                    <TextBlock
                        Text="Theo dõi đơn thuê, tình trạng phương tiện và hỗ trợ khách hàng trong quá trình nhận - trả xe."
                        Foreground="{StaticResource HeroText}"
                        FontSize="14"
                        TextWrapping="Wrap"
                        Margin="0,0,0,20"/>

                    <Button Content="Đi đến đơn thuê →"
                            Background="{StaticResource Surface}"
                            Foreground="{StaticResource PrimaryHover}"
                            BorderThickness="0"
                            Padding="20,12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            Command="{Binding DataContext.NavigateCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Bookings"/>

                </StackPanel>
            </Border>

            <!-- STAFF STATISTICS -->

            <TextBlock Text="Thống kê vận hành"
                       Style="{StaticResource SectionTitle}"/>

            <Border Style="{StaticResource StaffCard}"
                    Margin="0,0,0,28">

                <StackPanel>

                    <TextBlock
                        Text="Thống kê đơn thuê theo ngày tạo và tình trạng đội xe hiện tại."
                        Foreground="{StaticResource MutedReadable}"
                        FontSize="13"
                        Margin="0,0,0,18"
                        TextWrapping="Wrap"/>

                    <!-- DATE FILTER -->

                    <WrapPanel Margin="0,0,0,12">

                        <StackPanel Margin="0,0,16,12">

                            <TextBlock Text="Từ ngày"
                                       Foreground="{StaticResource MutedReadable}"
                                       Margin="0,0,0,6"/>

                            <DatePicker Style="{StaticResource RoundedDatePicker}" Width="175"
                                        SelectedDate="{Binding FromDate, Mode=TwoWay}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,16,12">

                            <TextBlock Text="Đến ngày"
                                       Foreground="{StaticResource MutedReadable}"
                                       Margin="0,0,0,6"/>

                            <DatePicker Style="{StaticResource RoundedDatePicker}" Width="175"
                                        SelectedDate="{Binding ToDate, Mode=TwoWay}"/>

                        </StackPanel>

                        <Button Content="Cập nhật thống kê"
                                Style="{StaticResource StaffActionButton}"
                                Command="{Binding RefreshCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,12"/>

                    </WrapPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedReadable}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <!-- KPI -->

                    <WrapPanel Visibility="{Binding HasData,
                                Converter={StaticResource BoolToVisibility}}">

                        <Border Style="{StaticResource StaffKpiCard}">
                            <StackPanel>
                                <TextBlock Text="Tổng đơn thuê"
                                           Foreground="{StaticResource MutedReadable}"/>
                                <TextBlock Text="{Binding Snapshot.TotalBookings}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryHover}"/>
                                <TextBlock Text="Theo khoảng ngày"
                                           Foreground="{StaticResource MutedReadable}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StaffKpiCard}"
                                Background="{StaticResource PrimarySoft}">
                            <StackPanel>
                                <TextBlock Text="Chờ đặt cọc"
                                           Foreground="{StaticResource MutedReadable}"/>
                                <TextBlock Text="{Binding Snapshot.PendingDeposit}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryHover}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StaffKpiCard}"
                                Background="{StaticResource HighlightSoft}">
                            <StackPanel>
                                <TextBlock Text="Đã xác nhận"
                                           Foreground="{StaticResource MutedReadable}"/>
                                <TextBlock Text="{Binding Snapshot.Confirmed}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource HighlightInk}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StaffKpiCard}">
                            <StackPanel>
                                <TextBlock Text="Xe đang thuê"
                                           Foreground="{StaticResource MutedReadable}"/>
                                <TextBlock Text="{Binding Snapshot.VehiclesInUse}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryHover}"/>
                                <TextBlock Text="Trạng thái hiện tại"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedReadable}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StaffKpiCard}"
                                Background="{StaticResource DangerSoft}">
                            <StackPanel>
                                <TextBlock Text="Xe đang bảo trì"
                                           Foreground="{StaticResource MutedReadable}"/>
                                <TextBlock Text="{Binding Snapshot.VehiclesInMaintenance}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Danger}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StaffKpiCard}"
                                Background="{StaticResource SurfaceMuted}">
                            <StackPanel>
                                <TextBlock Text="Tổng số xe"
                                           Foreground="{StaticResource MutedReadable}"/>
                                <TextBlock Text="{Binding Snapshot.TotalVehicles}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Ink}"/>
                            </StackPanel>
                        </Border>

                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- BOOKING STATUS -->

            <Border Style="{StaticResource StaffCard}"
                    Margin="0,0,0,28"
                    Visibility="{Binding HasData,
                        Converter={StaticResource BoolToVisibility}}">

                <StackPanel>

                    <TextBlock Text="Trạng thái các đơn thuê"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock
                        Text="Số lượng đơn được tạo trong khoảng thời gian đã chọn."
                        Foreground="{StaticResource MutedReadable}"
                        Margin="0,0,0,12"
                        TextWrapping="Wrap"/>

                    <UniformGrid Columns="2">

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Chờ cọc: " Width="140"/>
                            <TextBlock Text="{Binding Snapshot.PendingDeposit}"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Đã xác nhận: " Width="140"/>
                            <TextBlock Text="{Binding Snapshot.Confirmed}"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Đang thuê: " Width="140"/>
                            <TextBlock Text="{Binding Snapshot.InUse}"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Đã trả xe: " Width="140"/>
                            <TextBlock Text="{Binding Snapshot.Returned}"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Hoàn tất: " Width="140"/>
                            <TextBlock Text="{Binding Snapshot.Completed}"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Đã hủy: " Width="140"/>
                            <TextBlock Text="{Binding Snapshot.Cancelled}"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Hết hạn: " Width="140"/>
                            <TextBlock Text="{Binding Snapshot.Expired}"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- QUICK ACTIONS -->

            <TextBlock Text="Truy cập nhanh"
                       Style="{StaticResource SectionTitle}"/>

            <UniformGrid Columns="3"
                         Margin="0,0,0,28">

                <Border Style="{StaticResource StaffCard}"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Đơn thuê"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"/>

                        <TextBlock
                            Text="Xem danh sách và tiếp tục xử lý các đơn thuê."
                            Foreground="{StaticResource MutedReadable}"
                            TextWrapping="Wrap"
                            Margin="0,10,0,18"/>

                        <Button Content="Xem đơn thuê"
                                Style="{StaticResource StaffActionButton}"
                                Command="{Binding DataContext.NavigateCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Bookings"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StaffCard}"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Đội xe"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"/>

                        <TextBlock
                            Text="Tra cứu xe, biển số và trạng thái hoạt động."
                            Foreground="{StaticResource MutedReadable}"
                            TextWrapping="Wrap"
                            Margin="0,10,0,18"/>

                        <Button Content="Xem danh sách xe"
                                Style="{StaticResource StaffActionButton}"
                                Command="{Binding DataContext.NavigateCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Vehicles"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StaffCard}">
                    <StackPanel>
                        <TextBlock Text="Tài xế"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"/>

                        <TextBlock
                            Text="Tra cứu danh sách và thông tin liên hệ tài xế."
                            Foreground="{StaticResource MutedReadable}"
                            TextWrapping="Wrap"
                            Margin="0,10,0,18"/>

                        <Button Content="Xem tài xế"
                                Style="{StaticResource StaffActionButton}"
                                Command="{Binding DataContext.NavigateCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Drivers"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- WORKFLOW -->

            <TextBlock Text="Quy trình vận hành"
                       Style="{StaticResource SectionTitle}"/>

            <Border Style="{StaticResource StaffCard}">

                <UniformGrid Columns="3">

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="1. Kiểm tra đơn"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="{StaticResource PrimaryHover}"/>
                        <TextBlock
                            Text="Kiểm tra khách hàng, phương tiện và thời gian thuê."
                            Foreground="{StaticResource MutedReadable}"
                            TextWrapping="Wrap"
                            Margin="0,9,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="2. Bàn giao xe"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="{StaticResource PrimaryHover}"/>
                        <TextBlock
                            Text="Xác nhận thông tin khi khách hàng nhận xe."
                            Foreground="{StaticResource MutedReadable}"
                            TextWrapping="Wrap"
                            Margin="0,9,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="3. Tiếp nhận xe trả"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="{StaticResource PrimaryHover}"/>
                        <TextBlock
                            Text="Kiểm tra tình trạng xe khi khách hàng trả."
                            Foreground="{StaticResource MutedReadable}"
                            TextWrapping="Wrap"
                            Margin="0,9,0,0"/>
                    </StackPanel>

                </UniformGrid>
            </Border>

        </StackPanel>

    </ScrollViewer>
</Page>
