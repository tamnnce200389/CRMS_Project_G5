<Page x:Class="CRMS.Views.Staff.StaffDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tổng quan nhân viên"
      Background="#F4F8F6"
      FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="StaffActionButton" TargetType="Button">
            <Setter Property="Background" Value="#16A085"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StaffCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFEAE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30,27,30,36">

            <!-- PAGE HEADER -->
            <TextBlock Text="Tổng quan nhân viên"
                       FontSize="29"
                       FontWeight="Bold"
                       Foreground="#102C26"/>

            <TextBlock Text="Không gian làm việc dành cho nhân viên vận hành CRMS."
                       Foreground="#64748B"
                       FontSize="14"
                       Margin="0,8,0,25"/>

            <!-- STAFF HERO -->
            <Border CornerRadius="18"
                    Padding="30"
                    Margin="0,0,0,28">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#115E50" Offset="0"/>
                        <GradientStop Color="#16A085" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="125"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STAFF WORKSPACE"
                                   Foreground="#C7F5E8"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Sẵn sàng cho ca làm việc!"
                                   Foreground="White"
                                   FontSize="29"
                                   FontWeight="Bold"
                                   Margin="0,13,0,10"/>

                        <TextBlock Text="Theo dõi đơn thuê, xác nhận thu cọc, phân công tài xế và đối soát hoàn tiền cọc nhanh chóng."
                                   Foreground="#E1F7EF"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   MaxWidth="620"
                                   Margin="0,0,0,20"/>

                        <WrapPanel>
                            <Button Content="Đi đến đơn thuê →"
                                    Tag="Bookings"
                                    Click="NavigateButton_Click"
                                    Background="White"
                                    Foreground="#047857"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Padding="20,12"
                                    Margin="0,0,12,0"/>
                            <Button Content="Tổng hợp thanh toán →"
                                    Tag="PaymentSummary"
                                    Click="NavigateButton_Click"
                                    Background="#0D9488"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Padding="20,12"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="105"
                            Height="105"
                            CornerRadius="53"
                            Background="#307D70"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <TextBlock Text="&#xE8A1;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="49"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- QUICK ACTIONS -->
            <TextBlock Text="Truy cập nhanh"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#102C26"
                       Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- BOOKINGS -->
                <Border Grid.Column="0"
                        Style="{StaticResource StaffCard}"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <Border Background="#DDF7EE"
                                CornerRadius="11"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left">

                            <TextBlock Text="&#xE8A1;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#059669"
                                       FontSize="23"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Đơn thuê"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#102C26"
                                   Margin="0,17,0,9"/>

                        <TextBlock Text="Xem danh sách đơn, xác nhận cọc tiền mặt, phân công tài xế và hoàn cọc."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   MinHeight="62"
                                   FontSize="13"/>

                        <Button Content="Xem đơn thuê →"
                                Tag="Bookings"
                                Click="NavigateButton_Click"
                                Style="{StaticResource StaffActionButton}"
                                Margin="0,15,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- VEHICLES -->
                <Border Grid.Column="1"
                        Style="{StaticResource StaffCard}"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <Border Background="#E4F2FF"
                                CornerRadius="11"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left">

                            <TextBlock Text="&#xE804;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#2563EB"
                                       FontSize="23"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Đội xe"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#102C26"
                                   Margin="0,17,0,9"/>

                        <TextBlock Text="Tra cứu thông tin phương tiện, biển số và tình trạng hoạt động."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   MinHeight="62"
                                   FontSize="13"/>

                        <Button Content="Xem danh sách xe →"
                                Tag="Vehicles"
                                Click="NavigateButton_Click"
                                Style="{StaticResource StaffActionButton}"
                                Margin="0,15,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- DRIVERS -->
                <Border Grid.Column="2"
                        Style="{StaticResource StaffCard}">

                    <StackPanel>
                        <Border Background="#FFF2E2"
                                CornerRadius="11"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left">

                            <TextBlock Text="&#xE716;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#EA8B25"
                                       FontSize="23"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Tài xế"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#102C26"
                                   Margin="0,17,0,9"/>

                        <TextBlock Text="Tra cứu danh sách và phân công tài xế cho đơn có tài xế."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   MinHeight="62"
                                   FontSize="13"/>

                        <Button Content="Xem tài xế →"
                                Tag="Drivers"
                                Click="NavigateButton_Click"
                                Style="{StaticResource StaffActionButton}"
                                Margin="0,15,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- WORKFLOW WITH WORKING BUTTONS -->
            <TextBlock Text="Quy trình vận hành &amp; Thanh toán"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#102C26"
                       Margin="0,0,0,16"/>

            <Border Style="{StaticResource StaffCard}">
                <StackPanel>

                    <TextBlock Text="Các bước nghiệp vụ xử lý đơn thuê dành cho Staff"
                               Foreground="#64748B"
                               FontSize="13"
                               Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,20,0">

                            <Border Background="#DCFCE7"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    HorizontalAlignment="Left">

                                <TextBlock Text="1"
                                           FontWeight="Bold"
                                           Foreground="#166534"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Kiểm tra &amp; Thu cọc"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,11,0,6"/>

                            <TextBlock Text="Kiểm tra đơn thuê mới và xác nhận thu tiền cọc tại quầy."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       MinHeight="42"/>

                            <Button Content="Xác nhận cọc →"
                                    Tag="CashDeposit"
                                    Click="NavigateButton_Click"
                                    Style="{StaticResource StaffActionButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,20,0">

                            <Border Background="#DCFCE7"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    HorizontalAlignment="Left">

                                <TextBlock Text="2"
                                           FontWeight="Bold"
                                           Foreground="#166534"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Phân công tài xế"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,11,0,6"/>

                            <TextBlock Text="Chọn tài xế đang hoạt động cho các đơn thuê Có tài xế đã xác nhận."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       MinHeight="42"/>

                            <Button Content="Phân công tài xế →"
                                    Tag="DriverAssignment"
                                    Click="NavigateButton_Click"
                                    Style="{StaticResource StaffActionButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <Border Background="#DCFCE7"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    HorizontalAlignment="Left">

                                <TextBlock Text="3"
                                           FontWeight="Bold"
                                           Foreground="#166534"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Đối soát &amp; Hoàn cọc"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,11,0,6"/>

                            <TextBlock Text="Tổng hợp thanh toán và xác nhận hoàn tiền cọc cho các đơn đã hủy."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       MinHeight="42"/>

                            <Button Content="Tổng hợp thanh toán →"
                                    Tag="PaymentSummary"
                                    Click="NavigateButton_Click"
                                    Style="{StaticResource StaffActionButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
