<Page x:Class="CRMS.Views.Guest.CarSearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tìm kiếm xe"
      Background="#F5F6F8"
      FontFamily="Segoe UI">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible"/>

        <Style x:Key="GreenButton" TargetType="Button">
            <Setter Property="Background" Value="#59CA82"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#D8DEE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- CARD XE TU LAI / CO TAI XE -->
        <DataTemplate x:Key="ShortTermCardTemplate">
            <Border Background="White"
                    BorderBrush="#E1E6ED"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,0,14,18"
                    ClipToBounds="True">
                <StackPanel>

                    <Grid Height="190" Background="#F1F5F9">
                        <TextBlock Text="&#xE804;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="68"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Image Source="{Binding ImageUrl}"
                               Stretch="UniformToFill"/>
                    </Grid>

                    <StackPanel Margin="16">
                        <TextBlock Text="{Binding Brand}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="{Binding Model}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,8"/>

                        <TextBlock Text="{Binding CategoryName}"
                                   FontSize="13"
                                   Foreground="#16A34A"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <TextBlock Text="{Binding Transmission}"
                                       FontSize="12"
                                       Foreground="#475569"/>
                            <TextBlock Text="  •  "
                                       Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding FuelType}"
                                       FontSize="12"
                                       Foreground="#475569"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SeatCount,
                            StringFormat={}{0} chỗ}"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,0,0,12"/>

                        <Separator Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding DailyRate,
                            StringFormat={}{0:N0} ₫/ngày}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0,0,0,12"/>


                        <Button Content="Chọn xe"
                                Height="39"
                                Background="#57C985"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Tag="{Binding VehicleId}"
                                Click="SelectCar_Click"/>

                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- CARD XE DAI HAN GIONG MAU -->
        <DataTemplate x:Key="LongTermCardTemplate">
            <Border Background="White"
                    BorderBrush="#DEDEDE"
                    BorderThickness="1"
                    CornerRadius="16"
                    Margin="0,0,18,20"
                    ClipToBounds="True">

                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="230"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TEN XE -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,2,0,16">

                        <TextBlock Text="{Binding Brand}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="{Binding Model,
                            StringFormat={} {0}}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- THONG SO VA NHAN -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="{Binding Transmission}"
                                       FontSize="13"
                                       Foreground="#334155"/>

                            <TextBlock Text="  •  "
                                       Foreground="#94A3B8"/>

                            <TextBlock Text="{Binding FuelType}"
                                       FontSize="13"
                                       Foreground="#334155"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#F0FFF5"
                                BorderBrush="#59CA82"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="10,6">

                            <TextBlock Text="Có gói thuê dài hạn"
                                       Foreground="#15803D"
                                       FontSize="12"/>
                        </Border>
                    </Grid>

                    <!-- ANH XE LON -->
                    <Grid Grid.Row="2"
                          Background="White"
                          Margin="0,5,0,8">

                        <TextBlock Text="&#xE804;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="85"
                                   Foreground="#E2E8F0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Image Source="{Binding ImageUrl}"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"/>
                    </Grid>

                    <!-- GIA + NUT CHON XE -->
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,12,4">

                            <TextBlock Text="Giá ưu đãi gói 3 tháng"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Bottom">

                                <TextBlock Text="{Binding LongTermBaseMonthlyRate,
                                    StringFormat={}{0:N0}}"
                                           TextDecorations="Strikethrough"
                                           Foreground="#9CA3AF"
                                           FontSize="13"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,8,3"/>

                                <TextBlock Text="{Binding LongTermMonthlyRate,
                                    StringFormat={}{0:N0}}"
                                           Foreground="#59CA82"
                                           FontWeight="Bold"
                                           FontSize="23"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>

                            <TextBlock Text="₫/tháng"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       Margin="0,1,0,0"/>

                            <TextBlock Text="Giảm 2% khi thuê gói 3 tháng"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Chọn xe"
                                Width="125"
                                Height="58"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource GreenButton}"
                                Click="LongTermChoose_Click"/>
                    </Grid>

                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel>

            <!-- DAU TRANG: QUAY LAI + DIA DIEM -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="28,18">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="← Quay lại"
                            Height="38"
                            Style="{StaticResource FilterButton}"
                            Click="BackToHome_Click"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="⌖"
                                   FontSize="23"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="Cần Thơ"
                                   FontSize="19"
                                   Foreground="#111827"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="CRMS"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#59CA82"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ============================ -->
            <!-- XE TU LAI / XE CO TAI XE     -->
            <!-- ============================ -->
            <StackPanel Margin="28,26,28,35"
                        Visibility="{Binding IsShortTerm,
                            Converter={StaticResource BoolVisible}}">

                <TextBlock Text="Tìm xe phù hợp"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Khám phá đội xe của CRMS"
                           Foreground="#64748B"
                           Margin="0,8,0,20"/>

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Bộ lọc xe"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0">
                                <TextBlock Text="Hãng hoặc mẫu xe"
                                           Margin="0,0,0,6"/>
                                <TextBox Height="40"
                                         Padding="10,7"
                                         Text="{Binding SearchText,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,10,0">
                                <TextBlock Text="Loại xe"
                                           Margin="0,0,0,6"/>
                                <ComboBox Height="40"
                                          ItemsSource="{Binding Categories}"
                                          DisplayMemberPath="CategoryName"
                                          SelectedItem="{Binding SelectedCategory}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,10,0">
                                <TextBlock Text="Giá từ / ngày"
                                           Margin="0,0,0,6"/>
                                <TextBox Height="40"
                                         Padding="10,7"
                                         Text="{Binding MinPrice,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Giá đến / ngày"
                                           Margin="0,0,0,6"/>
                                <TextBox Height="40"
                                         Padding="10,7"
                                         Text="{Binding MaxPrice,
                                             UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,16,0,0">

                            <Button Content="Xóa bộ lọc"
                                    Command="{Binding ClearFilterCommand}"
                                    Padding="16,9"
                                    Margin="0,0,10,0"/>

                            <Button Content="Tìm kiếm"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource GreenButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#64748B"
                           Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding Cars}"
                              ItemTemplate="{StaticResource ShortTermCardTemplate}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- ============================ -->
            <!-- THUE XE DAI HAN             -->
            <!-- ============================ -->
            <StackPanel Visibility="{Binding IsLongTerm,
                Converter={StaticResource BoolVisible}}">

                <!-- THANH BO LOC NGANG -->
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        Padding="28,15">

                    <StackPanel>
                        <WrapPanel HorizontalAlignment="Center">

                            <ComboBox Width="155"
                                      Height="39"
                                      Margin="5"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort}"
                                      ToolTip="Sắp xếp danh sách xe"/>

                            <ComboBox Width="155"
                                      Height="39"
                                      Margin="5"
                                      ItemsSource="{Binding TransmissionOptions}"
                                      SelectedItem="{Binding SelectedTransmission}"
                                      ToolTip="Lọc theo hộp số"/>

                            <ComboBox Width="170"
                                      Height="39"
                                      Margin="5"
                                      ItemsSource="{Binding Categories}"
                                      DisplayMemberPath="CategoryName"
                                      SelectedItem="{Binding SelectedCategory}"
                                      ToolTip="Loại xe"/>

                            <TextBox Width="195"
                                     Height="39"
                                     Margin="5"
                                     Padding="10,8"
                                     Text="{Binding SearchText,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Nhập hãng hoặc mẫu xe"/>

                            <Button Content="Tìm kiếm"
                                    Height="39"
                                    Margin="5"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource GreenButton}"/>

                            <Button Content="Bộ lọc giá"
                                    Height="39"
                                    Margin="5"
                                    Style="{StaticResource FilterButton}"
                                    Click="ToggleLongTermFilter_Click"/>
                        </WrapPanel>

                        <!-- MO RONG BO LOC GIA -->
                        <Border x:Name="LongTermPriceFilter"
                                Visibility="Collapsed"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,1,0,0"
                                Margin="0,15,0,0"
                                Padding="0,15,0,0">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <TextBlock Text="Giá/tháng từ:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <TextBox Width="145"
                                         Height="37"
                                         Padding="9,6"
                                         Text="{Binding MinPrice,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,18,0"/>

                                <TextBlock Text="Đến:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <TextBox Width="145"
                                         Height="37"
                                         Padding="9,6"
                                         Text="{Binding MaxPrice,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,15,0"/>

                                <Button Content="Xóa lọc"
                                        Padding="12,7"
                                        Command="{Binding ClearFilterCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- DANH SACH 3 COT -->
                <StackPanel Margin="28,24,10,35">

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#64748B"
                               Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding Cars}"
                                  ItemTemplate="{StaticResource LongTermCardTemplate}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
