<Page x:Class="CRMS.Views.Guest.CarSearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tìm kiếm xe"
      Background="#F5F7FB">

    <Page.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Styles -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#57C985"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ====================================== -->
        <!-- CARD XE TU LAI / XE CO TAI XE          -->
        <!-- ====================================== -->
        <DataTemplate x:Key="ShortTermCardTemplate">

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,0,14,18"
                    ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Image -->
                    <Grid Grid.Row="0"
                          Height="185"
                          Background="#EEF2F7"
                          ClipToBounds="True">

                        <TextBlock Text="&#xE804;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="65"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Image Source="{Binding ImageUrl}"
                               Stretch="UniformToFill"/>
                    </Grid>

                    <!-- Information -->
                    <StackPanel Grid.Row="1"
                                Margin="15">

                        <TextBlock Text="{Binding Brand}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding Model}"
                                   FontSize="16"
                                   Foreground="#334155"
                                   Margin="0,3,0,8"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding CategoryName}"
                                   FontSize="12"
                                   Foreground="#16A34A"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <!-- Transmission -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,7">

                            <TextBlock Text="Hộp số: "
                                       Foreground="#64748B"
                                       FontSize="12"/>

                            <TextBlock Text="{Binding Transmission}"
                                       Foreground="#334155"
                                       FontSize="12"/>
                        </StackPanel>

                        <!-- Seats and Fuel -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">

                            <TextBlock Text="{Binding SeatCount}"
                                       FontSize="12"
                                       Foreground="#334155"/>

                            <TextBlock Text=" chỗ  •  "
                                       FontSize="12"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding FuelType}"
                                       FontSize="12"
                                       Foreground="#334155"/>
                        </StackPanel>

                        <Separator Margin="0,5,0,12"
                                   Background="#E2E8F0"/>

                        <TextBlock Text="Giá thuê tham khảo"
                                   Foreground="#64748B"
                                   FontSize="11"/>

                        <TextBlock Text="{Binding DailyRate,
                                   StringFormat={}{0:N0} ₫/ngày}"
                                   Foreground="#16A34A"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,5,0,12"/>

                        <!-- Noi chuc nang chon xe o buoc sau -->
                        <Button Content="Chọn xe"
                                Height="39"
                                Background="#57C985"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                IsEnabled="False"
                                ToolTip="Chức năng chọn xe sẽ được tích hợp sau"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ====================================== -->
        <!-- CARD XE THUE DAI HAN                   -->
        <!-- ====================================== -->
        <DataTemplate x:Key="LongTermCardTemplate">

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,0,18,20"
                    ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Height="260"
                          Background="#F8FAFC"
                          ClipToBounds="True">

                        <TextBlock Text="&#xE804;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="85"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Image Source="{Binding ImageUrl}"
                               Stretch="Uniform"/>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="20">

                        <TextBlock FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,10">

                            <Run Text="{Binding Brand}"/>
                            <Run Text="{Binding Model}"/>
                        </TextBlock>

                        <TextBlock Text="{Binding CategoryName}"
                                   Foreground="#16A34A"
                                   FontSize="13"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,9">

                            <TextBlock Text="{Binding Transmission}"
                                       FontSize="13"
                                       Foreground="#475569"/>

                            <TextBlock Text="  •  "
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding FuelType}"
                                       FontSize="13"
                                       Foreground="#475569"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SeatCount,
                                   StringFormat={}{0} chỗ}"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   Margin="0,0,0,14"/>

                        <Separator Margin="0,0,0,12"/>

                        <!-- Gia theo ngay tu SQL -->
                        <TextBlock Text="{Binding DailyRate,
                                   StringFormat={}{0:N0} ₫/ngày}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"/>

                        <TextBlock Text="Giá thuê theo tháng: đang cập nhật"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Margin="0,7,0,15"/>

                        <Button Content="Chọn xe"
                                Height="44"
                                Background="#57C985"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                IsEnabled="False"
                                ToolTip="Chức năng thuê xe dài hạn sẽ được tích hợp sau"/>

                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <!-- MAIN CONTENT -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30,25,20,35">
            <!-- Back to Home -->
            <Button Content="← Quay lại Trang chủ"
        Width="180"
        Height="40"
        HorizontalAlignment="Left"
        Background="White"
        Foreground="#334155"
        BorderBrush="#CBD5E1"
        Cursor="Hand"
        Margin="0,0,0,20"
        Click="BackToHome_Click"/>

            <!-- TITLE -->
            <TextBlock Text="Tìm xe phù hợp"
                       FontSize="29"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Khám phá đội xe của CRMS"
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,7,0,22"/>

            <!-- ====================================== -->
            <!-- FILTER AREA                            -->
            <!-- ====================================== -->
            <Border Background="White"
                    CornerRadius="14"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Bộ lọc xe"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Keyword -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Hãng hoặc mẫu xe"
                                       Style="{StaticResource FilterLabel}"
                                       Margin="0,0,0,8"/>

                            <TextBox Height="42"
                                     Padding="10,8"
                                     FontSize="14"
                                     Text="{Binding SearchText,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Loại xe"
                                       Style="{StaticResource FilterLabel}"
                                       Margin="0,0,0,8"/>

                            <ComboBox Height="42"
                                      FontSize="14"
                                      ItemsSource="{Binding Categories}"
                                      DisplayMemberPath="CategoryName"
                                      SelectedItem="{Binding SelectedCategory}"/>
                        </StackPanel>

                        <!-- Min price -->
                        <StackPanel Grid.Column="2"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Giá từ (VNĐ/ngày)"
                                       Style="{StaticResource FilterLabel}"
                                       Margin="0,0,0,8"/>

                            <TextBox Height="42"
                                     Padding="10,8"
                                     Text="{Binding MinPrice,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Max price -->
                        <StackPanel Grid.Column="3">

                            <TextBlock Text="Giá đến (VNĐ/ngày)"
                                       Style="{StaticResource FilterLabel}"
                                       Margin="0,0,0,8"/>

                            <TextBox Height="42"
                                     Padding="10,8"
                                     Text="{Binding MaxPrice,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                    </Grid>

                    <!-- Filter buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">

                        <Button Content="Xóa bộ lọc"
                                Command="{Binding ClearFilterCommand}"
                                Padding="18,10"
                                Margin="0,0,10,0"
                                Cursor="Hand"/>

                        <Button Content="Tìm kiếm"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource SearchButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- STATUS -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#475569"
                       FontSize="15"
                       Margin="0,0,0,18"/>

            <!-- ====================================== -->
            <!-- SELF DRIVE / WITH DRIVER               -->
            <!-- ====================================== -->
            <StackPanel Visibility="{Binding IsShortTerm,
                         Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="Danh sách xe thuê ngắn hạn"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,14"/>

                <ItemsControl ItemsSource="{Binding Cars}"
                              ItemTemplate="{StaticResource ShortTermCardTemplate}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                </ItemsControl>
            </StackPanel>

            <!-- ====================================== -->
            <!-- LONG TERM                             -->
            <!-- ====================================== -->
            <StackPanel Visibility="{Binding IsLongTerm,
                         Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="Danh sách xe thuê dài hạn"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Địa điểm áp dụng: Cần Thơ"
                           Foreground="#64748B"
                           Margin="0,0,0,18"/>

                <ItemsControl ItemsSource="{Binding Cars}"
                              ItemTemplate="{StaticResource LongTermCardTemplate}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
