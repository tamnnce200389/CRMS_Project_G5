<Page x:Class="CRMS.Views.Guest.CarDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Chi tiết xe" Background="#F3F6FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="22" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="HÌNH ẢNH XE" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Border Height="280" Background="#E8EEF5" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="72"
                                       Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="VehicleImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Thông tin phương tiện" FontSize="22" FontWeight="Bold" Margin="0,22,0,12"/>
                    <TextBlock x:Name="CategoryText" Margin="0,4"/>
                    <TextBlock x:Name="YearText" Margin="0,4"/>
                    <TextBlock x:Name="SeatText" Margin="0,4"/>
                    <TextBlock x:Name="TransmissionText" Margin="0,4"/>
                    <TextBlock x:Name="FuelText" Margin="0,4"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="24" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="BrandText" FontSize="27" FontWeight="Bold" Foreground="#142B45"/>
                    <TextBlock x:Name="ModelText" FontSize="22" Margin="0,3,0,8"/>
                    <TextBlock x:Name="RateText" FontSize="23" FontWeight="Bold" Foreground="#16A34A"/>
                    <Border x:Name="LongTermBanner" Visibility="Collapsed" Background="#DCFCE7"
                            BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,4">
                        <TextBlock x:Name="LongTermBannerText" Foreground="#166534" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="DescriptionText" Text="Giá thuê, phí tài xế, voucher và tiền cọc được tính theo chính sách hệ thống."
                               Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <Separator Margin="0,0,0,16"/>
                    <TextBlock Text="THÔNG TIN ĐẶT XE" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Hình thức thuê" Foreground="#64748B"/>
                    <ComboBox x:Name="RentalTypeBox" Height="36" Margin="0,5,0,12" SelectedIndex="0"
                              SelectionChanged="RentalTypeBox_SelectionChanged">
                        <ComboBoxItem Content="Tự lái" Tag="SelfDrive"/>
                        <ComboBoxItem Content="Có tài xế" Tag="WithDriver"/>
                    </ComboBox>

                    <!-- PANEL CHỌN LOẠI GÓI THUÊ DÀI HẠN (HIỆN THÊM KHI THUÊ DÀI HẠN) -->
                    <StackPanel x:Name="LongTermPlanPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Gói thuê dài hạn" Foreground="#64748B"/>
                        <ComboBox x:Name="LongTermPlanBox" Height="36" Margin="0,5,0,0"
                                  SelectionChanged="LongTermPlanBox_SelectionChanged">
                            <ComboBoxItem Content="Gói 1 tháng (Giá tiêu chuẩn)" Tag="1"/>
                            <ComboBoxItem Content="Gói 3 tháng (Ưu đãi -2%)" Tag="3"/>
                            <ComboBoxItem Content="Gói 6 tháng (Ưu đãi -3%)" Tag="6"/>
                            <ComboBoxItem Content="Gói 9 tháng (Ưu đãi -4%)" Tag="9"/>
                            <ComboBoxItem Content="Gói 12 tháng (Ưu đãi -5%)" Tag="12"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- NGÀY GIỜ NHẬN / TRẢ XE LUÔN HIỂN THỊ RÕ RÀNG -->
                    <StackPanel x:Name="ShortTermDatePanel">
                        <TextBlock Text="Ngày nhận xe" Foreground="#64748B"/>
                        <DatePicker x:Name="StartDate" Height="34" Margin="0,5,0,10"/>
                        <TextBlock Text="Giờ nhận xe (HH:mm)" Foreground="#64748B"/>
                        <TextBox x:Name="StartTime" Text="09:00" Height="34" Padding="8" Margin="0,5,0,10"/>
                        <TextBlock Text="Ngày trả xe" Foreground="#64748B"/>
                        <DatePicker x:Name="EndDate" Height="34" Margin="0,5,0,10"/>
                        <TextBlock Text="Giờ trả xe (HH:mm)" Foreground="#64748B"/>
                        <TextBox x:Name="EndTime" Text="09:00" Height="34" Padding="8" Margin="0,5,0,12"/>
                    </StackPanel>

                    <Border x:Name="VoucherSection" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Ưu đãi Voucher (không bắt buộc)" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Xem Voucher khả dụng" Padding="10,5"
                                        Background="#E8F2ED" Foreground="#176B53" BorderBrush="#C6DED2"
                                        Click="LoadVouchers_Click"/>
                            </DockPanel>
                            <ComboBox x:Name="VoucherBox" Height="34" Margin="0,0,0,8"
                                      DisplayMemberPath="DisplayText" SelectedValuePath="VoucherCode"
                                      SelectionChanged="VoucherBox_SelectionChanged"/>
                            <TextBox x:Name="VoucherCodeBox" Height="34" Padding="8"
                                     ToolTip="Nhập mã Voucher hoặc chọn từ danh sách trên"
                                     TextChanged="VoucherCodeBox_TextChanged"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="ApplyVoucherButton" Content="Kiểm tra &amp; áp dụng thử"
                                        Padding="12,6" Margin="0,0,8,0" Background="#176B53" Foreground="White"
                                        Click="ApplyVoucher_Click"/>
                                <Button Content="Bỏ Voucher" Padding="12,6" Background="#F1F5F9" Foreground="#334155"
                                        Click="ClearVoucher_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="VoucherMessageText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#475569" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Phương thức đặt cọc" Foreground="#64748B"/>
                    <ComboBox x:Name="DepositMethodBox" Height="36" Margin="0,5,0,12" SelectedIndex="0">
                        <ComboBoxItem Content="VNPay" Tag="VNPay"/>
                        <ComboBoxItem Content="Tiền mặt" Tag="Cash"/>
                    </ComboBox>
                    <Border Background="#F0FDF4" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Chi phí tham khảo" Foreground="#64748B"/>
                            <TextBlock x:Name="EstimateText" Text="Chọn thời gian thuê để xem ước tính"
                                       FontSize="16" FontWeight="Bold" Foreground="#15803D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock x:Name="DepositEstimateText" Text=""
                                       FontSize="13" FontWeight="SemiBold" Foreground="#166534" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="Số tiền chính thức và tiền cọc do hệ thống kiểm tra và khóa lịch khi tạo đơn."
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="PlaceButton" Content="Đặt xe" Height="46" Background="#16A34A"
                            Foreground="White" FontWeight="Bold" Click="PlaceBooking_Click"/>
                    <Button Content="Quay lại" Height="42" Margin="0,10,0,0" Click="Back_Click"/>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#475569" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
