<Window x:Class="CRMS.Views.Guest.FilterHelpWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="600" SizeToContent="Height" WindowStartupLocation="CenterOwner"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 FontFamily="Segoe UI" FontSize="17" Foreground="{StaticResource Ink}" ShowInTaskbar="False">
 <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1">
  <DockPanel>
   <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,18">
    <Grid>
     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="36,0"/>
     <Button Content="×" ToolTip="Đóng giải thích" AutomationProperties.Name="Đóng giải thích" Width="34" Height="34" MinHeight="34" Padding="0" FontSize="22" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
    </Grid>
   </Border>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="450">
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="28,24,28,28" LineHeight="28"/>
   </ScrollViewer>
  </DockPanel>
 </Border>
</Window>
