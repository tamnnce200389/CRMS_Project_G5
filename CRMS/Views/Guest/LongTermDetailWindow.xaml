<Window x:Class="CRMS.Views.Guest.LongTermDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết thuê xe dài hạn"
        Width="1250"
        Height="780"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- NUT CHON GOI THUE -->
        <Style x:Key="MonthButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,12"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1"
                Padding="22,0">

            <DockPanel LastChildFill="True">

                <Button DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryButton}"
                        Content="✕"
                        Width="36"
                        Height="36"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}"
                        Cursor="Hand"
                        Click="Close_Click"/>

                <TextBlock Text="CRMS | Chi tiết thuê xe dài hạn"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}"
                           VerticalAlignment="Center"/>

            </DockPanel>
        </Border>

        <!-- MAIN BODY -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="28">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="540"/>
                </Grid.ColumnDefinitions>

                <!-- ================================= -->
                <!-- BEN TRAI: THONG TIN VA ANH XE      -->
                <!-- ================================= -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,22,0">

                    <!-- CAR NAME -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,15,0,22">

                        <TextBlock Text="{Binding Car.Brand}"
                                   FontSize="35"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"/>

                        <TextBlock Text="{Binding Car.Model}"
                                   FontSize="35"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"
                                   Margin="12,0,0,0"/>

                    </StackPanel>

                    <!-- CAR IMAGE -->
                    <Border Height="445"
                            Background="{StaticResource SurfaceMuted}"
                            CornerRadius="16"
                            ClipToBounds="True">

                        <Grid>

                            <TextBlock Text="&#xE804;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="110"
                                       Foreground="{StaticResource Line}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Image Source="{Binding Car.ImageUrl}"
                                   Stretch="Uniform"/>

                        </Grid>
                    </Border>

                    <!-- CAR INFORMATION -->
                    <Border Background="{StaticResource PageBackground}"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,22,0,0">

                        <StackPanel>

                            <TextBlock Text="Thông tin xe"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Ink}"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="{Binding Car.CategoryName}"
                                       FontSize="15"
                                       Foreground="{StaticResource PrimaryPressed}"
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <TextBlock Text="Hộp số: "
                                           Foreground="{StaticResource MutedReadable}"/>

                                <TextBlock Text="{Binding Car.Transmission}"
                                           FontWeight="SemiBold"/>

                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <TextBlock Text="Nhiên liệu: "
                                           Foreground="{StaticResource MutedReadable}"/>

                                <TextBlock Text="{Binding Car.FuelType}"
                                           FontWeight="SemiBold"/>

                            </StackPanel>

                            <TextBlock Text="{Binding Car.SeatCount,
                                StringFormat={}{0} chỗ}"
                                       FontWeight="SemiBold"/>

                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ================================= -->
                <!-- BEN PHAI: CAC GOI THUE            -->
                <!-- ================================= -->
                <Border Grid.Column="1"
                        Background="{StaticResource PageBackground}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Gói thuê"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"
                                   Margin="0,0,0,20"/>

                        <!-- FIVE RENTAL PLANS -->
                        <UniformGrid Columns="5"
                                     Margin="0,0,0,20">

                            <Button x:Name="Month1Button"
                                    Tag="1" Command="{Binding SelectPlanCommand}" CommandParameter="1">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource MonthButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedMonths}" Value="1"><Setter Property="Background" Value="{StaticResource PrimarySoft}"/><Setter Property="BorderBrush" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="{StaticResource PrimaryPressed}"/></DataTrigger></Style.Triggers></Style></Button.Style>

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="1 tháng"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Month1Label}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedReadable}"
                                               HorizontalAlignment="Center"
                                               Margin="0,7,0,0"/>

                                </StackPanel>
                            </Button>

                            <Button x:Name="Month3Button"
                                    Tag="3" Command="{Binding SelectPlanCommand}" CommandParameter="3">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource MonthButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedMonths}" Value="3"><Setter Property="Background" Value="{StaticResource PrimarySoft}"/><Setter Property="BorderBrush" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="{StaticResource PrimaryPressed}"/></DataTrigger></Style.Triggers></Style></Button.Style>

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="3 tháng"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Month3Label}"
                                               Foreground="{StaticResource HighlightInk}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,7,0,0"/>

                                </StackPanel>
                            </Button>

                            <Button x:Name="Month6Button"
                                    Tag="6" Command="{Binding SelectPlanCommand}" CommandParameter="6">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource MonthButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedMonths}" Value="6"><Setter Property="Background" Value="{StaticResource PrimarySoft}"/><Setter Property="BorderBrush" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="{StaticResource PrimaryPressed}"/></DataTrigger></Style.Triggers></Style></Button.Style>

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="6 tháng"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Month6Label}"
                                               Foreground="{StaticResource HighlightInk}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,7,0,0"/>

                                </StackPanel>
                            </Button>

                            <Button x:Name="Month9Button"
                                    Tag="9" Command="{Binding SelectPlanCommand}" CommandParameter="9">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource MonthButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedMonths}" Value="9"><Setter Property="Background" Value="{StaticResource PrimarySoft}"/><Setter Property="BorderBrush" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="{StaticResource PrimaryPressed}"/></DataTrigger></Style.Triggers></Style></Button.Style>

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="9 tháng"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Month9Label}"
                                               Foreground="{StaticResource HighlightInk}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,7,0,0"/>

                                </StackPanel>
                            </Button>

                            <Button x:Name="Month12Button"
                                    Tag="12" Command="{Binding SelectPlanCommand}" CommandParameter="12">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource MonthButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedMonths}" Value="12"><Setter Property="Background" Value="{StaticResource PrimarySoft}"/><Setter Property="BorderBrush" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="{StaticResource PrimaryPressed}"/></DataTrigger></Style.Triggers></Style></Button.Style>

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="12 tháng"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Month12Label}"
                                               Foreground="{StaticResource HighlightInk}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,7,0,0"/>

                                </StackPanel>
                            </Button>

                        </UniformGrid>

                        <Separator Margin="0,0,0,20"/>

                        <!-- MANUFACTURE YEAR -->
                        <TextBlock Text="Năm sản xuất"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"
                                   Margin="0,0,0,12"/>

                        <Border Background="{StaticResource PrimarySoft}"
                                BorderBrush="{StaticResource PrimarySoftBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,20">

                            <TextBlock x:Name="YearText" Text="{Binding YearLabel}"
                                       
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryHover}"
                                       HorizontalAlignment="Center"/>

                        </Border>

                        <!-- PICKUP DATE -->
                        <TextBlock Text="Thời gian nhận xe"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"
                                   Margin="0,0,0,12"/>

                        <DatePicker Style="{StaticResource RoundedDatePicker}" x:Name="PickupDatePicker"
                                    Height="40"
                                    FontSize="15"
                                    SelectedDate="{Binding PickupDate}" DisplayDateStart="{Binding MinimumDate, Mode=OneWay}"
                                    Margin="0,0,0,12"/>

                        <TextBlock Text="Ngày trả dự kiến"
                                   Foreground="{StaticResource MutedReadable}"
                                   FontSize="12"/>

                        <TextBlock x:Name="ReturnDateText" Text="{Binding ReturnDateLabel}"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,5,0,20"/>

                        <Separator Margin="0,0,0,20"/>

                        <!-- ORIGINAL PRICE -->
                        <TextBlock Text="Giá gốc mỗi tháng"
                                   Foreground="{StaticResource MutedReadable}"
                                   FontSize="13"/>

                        <TextBlock x:Name="BaseMonthlyText" Text="{Binding BaseMonthlyLabel}"
                                   FontSize="15"
                                   Foreground="{StaticResource MutedReadable}"
                                   TextDecorations="Strikethrough"
                                   Margin="0,6,0,15"/>

                        <!-- DISCOUNTED PRICE -->
                        <TextBlock Text="Giá thuê sau ưu đãi"
                                   Foreground="{StaticResource MutedReadable}"
                                   FontSize="13"/>

                        <TextBlock x:Name="MonthlyPriceText" Text="{Binding MonthlyLabel}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryHover}"
                                   Margin="0,6,0,10"/>

                        <TextBlock x:Name="DiscountText" Text="{Binding DiscountLabel}"
                                   Foreground="{StaticResource PrimaryPressed}"
                                   FontSize="13"
                                   Margin="0,0,0,15"/>

                        <!-- TOTAL -->
                        <TextBlock Text="Tổng tiền thuê theo gói"
                                   Foreground="{StaticResource MutedReadable}"
                                   FontSize="13"/>

                        <TextBlock x:Name="TotalPriceText" Text="{Binding TotalLabel}"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"
                                   Margin="0,7,0,18"/>

                        <TextBlock x:Name="StatusText" Text="{Binding Status}"
                                   Foreground="{StaticResource MutedReadable}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Button Style="{StaticResource PrimaryButton}" x:Name="ChoosePlanButton"
                                Content="CHỌN THUÊ"
                                Height="50"
                                FontSize="17"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ChooseCommand}"/>

                        <TextBlock Text="Giá hiển thị dựa trên bảng giá CRMS. Các khoản phí phát sinh và điều kiện đặt xe sẽ được xác định khi tạo đơn."
                                   Foreground="{StaticResource MutedReadable}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0"/>

                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

    </Grid>
</Window>


