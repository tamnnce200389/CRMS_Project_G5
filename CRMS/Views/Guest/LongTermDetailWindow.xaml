<Window x:Class="CRMS.Views.Guest.LongTermDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết thuê xe dài hạn"
        Width="1220"
        Height="760"
        MinWidth="1020"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="MonthButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,12"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="22,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="36"
                        Height="36"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        Foreground="#111827"
                        Cursor="Hand"
                        Click="Close_Click"/>

                <TextBlock Text="CRMS | Chi tiết thuê xe dài hạn"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- MAIN BODY -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="520"/>
                </Grid.ColumnDefinitions>

                <!-- BÊN TRÁI: THÔNG TIN VÀ ẢNH XE -->
                <StackPanel Grid.Column="0" Margin="0,0,22,0">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <TextBlock Text="{Binding Brand}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="{Binding Model}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="12,0,0,0"/>
                    </StackPanel>

                    <Border Height="420"
                            Background="#F1F5F9"
                            CornerRadius="16"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE804;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="110"
                                       Foreground="#CBD5E1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Image Source="{Binding ImageUrl}"
                                   Stretch="Uniform"/>
                        </Grid>
                    </Border>

                    <Border Background="#F8FAFC"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Thông tin xe"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Loại xe: " Foreground="#64748B"/>
                                <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" Foreground="#16A34A"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Hộp số: " Foreground="#64748B"/>
                                <TextBlock Text="{Binding Transmission}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Nhiên liệu: " Foreground="#64748B"/>
                                <TextBlock Text="{Binding FuelType}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SeatCount, StringFormat={}{0} chỗ}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- BÊN PHẢI: CÁC GÓI THUÊ DÀI HẠN & THỜI GIAN NHẬN - TRẢ -->
                <Border Grid.Column="1"
                        Background="#F7FAFC"
                        BorderBrush="#DCE4E9"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Chọn gói thuê dài hạn"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,16"/>

                        <!-- FIVE RENTAL PLANS -->
                        <UniformGrid Columns="5" Margin="0,0,0,18">
                            <Button x:Name="Month1Button" Tag="1" Click="Plan_Click" Style="{StaticResource MonthButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="1 tháng" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Giá gốc" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="Month3Button" Tag="3" Click="Plan_Click" Style="{StaticResource MonthButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="3 tháng" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="-2%" Foreground="#F97316" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="Month6Button" Tag="6" Click="Plan_Click" Style="{StaticResource MonthButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="6 tháng" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="-3%" Foreground="#F97316" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="Month9Button" Tag="9" Click="Plan_Click" Style="{StaticResource MonthButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="9 tháng" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="-4%" Foreground="#F97316" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="Month12Button" Tag="12" Click="Plan_Click" Style="{StaticResource MonthButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="12 tháng" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="-5%" Foreground="#F97316" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- LOẠI XE & KỲ HẠN -->
                        <Border Background="#DCFCE7"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,16">
                            <TextBlock x:Name="CategoryPlanText"
                                       Text="{Binding CategoryName}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#15803D"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- THỜI GIAN NHẬN XE & NGÀY TRẢ DỰ KIẾN -->
                        <TextBlock Text="Ngày bắt đầu nhận xe"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,8"/>

                        <DatePicker x:Name="PickupDatePicker"
                                    Height="38"
                                    FontSize="14"
                                    SelectedDateChanged="PickupDateChanged"
                                    Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Ngày trả xe dự kiến: "
                                       Foreground="#64748B"
                                       FontSize="14"/>
                            <TextBlock x:Name="ReturnDateText"
                                       FontWeight="Bold"
                                       Foreground="#15803D"
                                       FontSize="14"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,16"/>

                        <!-- ORIGINAL PRICE -->
                        <TextBlock Text="Giá gốc mỗi tháng"
                                   Foreground="#64748B"
                                   FontSize="13"/>

                        <TextBlock x:Name="BaseMonthlyText"
                                   FontSize="15"
                                   Foreground="#64748B"
                                   TextDecorations="Strikethrough"
                                   Margin="0,4,0,12"/>

                        <!-- DISCOUNTED PRICE -->
                        <TextBlock Text="Giá thuê sau ưu đãi"
                                   Foreground="#64748B"
                                   FontSize="13"/>

                        <TextBlock x:Name="MonthlyPriceText"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#57C985"
                                   Margin="0,4,0,8"/>

                        <TextBlock x:Name="DiscountText"
                                   Foreground="#16A34A"
                                   FontSize="13"
                                   Margin="0,0,0,12"/>

                        <!-- TOTAL -->
                        <TextBlock Text="Tổng tiền thuê theo gói"
                                   Foreground="#64748B"
                                   FontSize="13"/>

                        <TextBlock x:Name="TotalPriceText"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,5,0,14"/>

                        <TextBlock x:Name="StatusText"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <Button x:Name="ChoosePlanButton"
                                Content="CHỌN THUÊ"
                                Height="48"
                                Background="#57C985"
                                Foreground="White"
                                FontSize="17"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                IsEnabled="False"
                                Click="ChooseRental_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
