<Page x:Class="CRMS.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:CRMS.Services"
      Title="Trang chủ"
      Background="#F5F7FB">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="GuestVisibility"/>
        <Style x:Key="TopMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#111827"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ServiceTabButton" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Padding" Value="22,16"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>

        <Style x:Key="ActiveServiceTabButton" TargetType="Button" BasedOn="{StaticResource ServiceTabButton}">
            <Setter Property="Background" Value="#5AD07A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SearchLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,18,28,30">

            <!-- HEADER -->
            <Border Background="White"
                    CornerRadius="18"
                    Padding="22,16"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="10"
                                Background="#D1FAE5">
                            <TextBlock Text="&#xE804;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#22C55E"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="CRMS"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>
                            <TextBlock Text="Car Rental Management System"
                                       FontSize="11"
                                       Foreground="#6B7280"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Menu -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Content="Về chúng tôi"
                                Style="{StaticResource TopMenuButton}"/>
                        
                    </StackPanel>



                    <!-- LOGIN / REGISTER / LOGOUT -->
                    <StackPanel Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                        <!-- Register: Guest -->
                        <Button Content="Đăng ký"
            Style="{StaticResource TopMenuButton}"
            Margin="0,0,8,0"
            Click="Register_Click"
            Visibility="{Binding IsGuest,
                Source={x:Static services:CurrentUserService.Instance},
                Converter={StaticResource GuestVisibility}}"/>

                        <!-- Login: Guest -->
                        <Button Content="Đăng nhập"
            Style="{StaticResource OutlineButton}"
            Click="Login_Click"
            Visibility="{Binding IsGuest,
                Source={x:Static services:CurrentUserService.Instance},
                Converter={StaticResource GuestVisibility}}"/>

                        <!-- Logout: Customer -->
                        <Button Content="Đăng xuất"
            Style="{StaticResource OutlineButton}"
            Margin="8,0,0,0"
            Click="Logout_Click"
            Visibility="{Binding IsLoggedIn,
                Source={x:Static services:CurrentUserService.Instance},
                Converter={StaticResource GuestVisibility}}"/>

                    </StackPanel>


                </Grid>
            </Border>

            <!-- HERO -->
            <Grid Margin="0,0,0,110">
                <Border Height="520"
                        CornerRadius="28"
                        ClipToBounds="True">

                    <Grid>
                        <!-- nền hero -->
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#334155" Offset="0"/>
                                <GradientStop Color="#0F172A" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>

                        <!-- ảnh giả lập -->
                        <TextBlock Text="&#xE804;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="220"
                                   Foreground="#FFFFFF"
                                   Opacity="0.08"
                                   HorizontalAlignment="Left"
                                   Margin="60,90,0,0"
                                   VerticalAlignment="Top"/>

                        <TextBlock Text="&#xE804;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="180"
                                   Foreground="#FFFFFF"
                                   Opacity="0.06"
                                   HorizontalAlignment="Right"
                                   Margin="0,120,80,0"
                                   VerticalAlignment="Top"/>

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="CRMS - Đồng hành cùng bạn"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="trên mọi hành trình"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>

                            <Border Width="260"
                                    Height="2"
                                    Background="White"
                                    Opacity="0.8"
                                    Margin="0,22,0,18"
                                    HorizontalAlignment="Center"/>

                            <TextBlock Text="Dễ dàng thuê xe tự lái, xe có tài xế hoặc thuê dài hạn với nhiều lựa chọn phù hợp."
                                       Foreground="#E5E7EB"
                                       FontSize="18"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Width="780"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SEARCH BOX -->
                <Border Background="White"
                        CornerRadius="24"
                        Width="1100"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-85"
                        Padding="0"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel>

                        <!-- Tabs -->
                        <Border Background="Transparent"
                                Padding="18,18,18,0">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Content="Xe tự lái"
                                        Style="{StaticResource ActiveServiceTabButton}"/>

                                <Button Content="Xe có tài xế"
                                        Style="{StaticResource ServiceTabButton}"
                                        Margin="8,0,0,0"/>

                                <Button Content="Thuê xe dài hạn"
                                        Style="{StaticResource ServiceTabButton}"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Search fields -->
                        <Grid Margin="28,20,28,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Location -->
                            <Border Grid.Column="0"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,1,0"
                                    Padding="18,8,18,8">
                                <StackPanel>
                                    <TextBlock Text="Địa điểm"
                                               Style="{StaticResource SearchLabel}"/>
                                    <ComboBox Height="42"
                                              Margin="0,8,0,0"
                                              FontSize="15"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Cần Thơ"/>
                                        <ComboBoxItem Content="TP. Hồ Chí Minh"/>
                                        <ComboBoxItem Content="Hà Nội"/>
                                        <ComboBoxItem Content="Đà Nẵng"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Time -->
                            <Border Grid.Column="1"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,1,0"
                                    Padding="18,8,18,8">
                                <StackPanel>
                                    <TextBlock Text="Thời gian thuê"
                                               Style="{StaticResource SearchLabel}"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <DatePicker Grid.Column="0"
                                                    Height="42"
                                                    FontSize="15"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="–"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="#6B7280"/>

                                        <DatePicker Grid.Column="2"
                                                    Height="42"
                                                    FontSize="15"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Button -->
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Margin="20,0,0,0">
                                <Button Content="Tìm xe"
                                        Width="140"
                                        Height="48"
                                        Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ABOUT -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="VỀ CHÚNG TÔI"
                           Foreground="#22C55E"
                           FontSize="12"
                           FontWeight="Bold"/>
                <TextBlock Text="Giải pháp thuê xe linh hoạt và hiện đại"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,8,0,10"/>
                <TextBlock Text="CRMS mang đến trải nghiệm thuê xe thuận tiện, nhanh chóng và phù hợp với nhiều nhu cầu: đi lại cá nhân, công tác, gia đình hoặc thuê dài hạn."
                           FontSize="15"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           MaxWidth="980"/>
            </StackPanel>

            <!-- INFO CARDS -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Text="Xe tự lái"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Phù hợp cho cá nhân và gia đình muốn chủ động lịch trình."
                                   Foreground="#6B7280"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Text="Xe có tài xế"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Thoải mái di chuyển khi cần tài xế chuyên nghiệp và an toàn."
                                   Foreground="#6B7280"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource InfoCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Thuê xe dài hạn"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Giải pháp tiết kiệm cho doanh nghiệp hoặc khách hàng thuê theo tháng."
                                   Foreground="#6B7280"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>