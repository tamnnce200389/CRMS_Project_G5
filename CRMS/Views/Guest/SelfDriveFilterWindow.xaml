<Window x:Class="CRMS.Views.Guest.SelfDriveFilterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="820" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
 Background="White" Foreground="{StaticResource Ink}" FontSize="16">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleBool"/>
  <Style x:Key="TypeItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Tile" Background="White" BorderBrush="#DDDFDF" BorderThickness="1" CornerRadius="14" Padding="10" MinHeight="145">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#4CBF82"/><Setter TargetName="Tile" Property="Background" Value="#EAF8EF"/><Setter TargetName="Tile" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#F0FAF3"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="BrandItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" CornerRadius="8" Padding="9,10" Margin="4"><DockPanel>
     <RadioButton IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" Margin="0,0,14,0"/>
     <ContentPresenter/>
    </DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EAF8EF"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel>
  <Grid DockPanel.Dock="Top" Height="76">
   <TextBlock Text="{Binding Title}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <Button Content="×" FontSize="22" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Style="{StaticResource SecondaryButton}" Click="Close_Click" Padding="0"/>
  </Grid>
  <Border DockPanel.Dock="Bottom" Padding="24,18" BorderThickness="0,1,0,0" BorderBrush="#E2E5E3" Background="White">
   <Button Content="Áp dụng" Height="54" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" IsEnabled="{Binding IsReady}" FontSize="18"/>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="18,12,18,18">
    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" BorderThickness="0" Background="Transparent"
       Visibility="{Binding IsChoice, Converter={StaticResource VisibleBool}}" ItemContainerStyle="{StaticResource BrandItem}" Margin="0,5,0,0">
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding ChoiceColumns}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="18"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Visibility="{Binding IsRoute, Converter={StaticResource VisibleBool}}" Margin="10,6">
     <TextBlock Text="Hành trình" Margin="0,0,0,6"/>
     <ComboBox ItemsSource="{Binding RouteOptions}" SelectedItem="{Binding SelectedRoute}"/>
     <TextBlock Text="Điểm đón" Margin="0,16,0,6"/>
     <ComboBox ItemsSource="{Binding RouteCities}" DisplayMemberPath="CityName" SelectedItem="{Binding PickupCity}"/>
     <TextBlock Text="Điểm đến" Margin="0,16,0,6"/>
     <ComboBox ItemsSource="{Binding RouteCities}" DisplayMemberPath="CityName" SelectedItem="{Binding RouteDestination}" IsEnabled="{Binding IsInterCity}"/>
     <TextBlock Text="Thời gian chuyến đi" Margin="0,16,0,6"/>
     <Button Content="{Binding PeriodLabel}" Style="{StaticResource SecondaryButton}" Click="RouteTime_Click"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" BorderThickness="0" Background="Transparent"
       Visibility="{Binding IsCategory, Converter={StaticResource VisibleBool}}" ItemContainerStyle="{StaticResource TypeItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center">
      <Path Data="{Binding BodyGeometry}" Width="76" Height="43" Stretch="Uniform" Stroke="#59655F" StrokeThickness="1.1" Margin="0,10,0,13"/>
      <TextBlock Text="{Binding Label}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding CountLabel}" FontSize="13" Foreground="{StaticResource MutedReadable}" HorizontalAlignment="Center" Margin="0,5,0,2"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <ListBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" BorderThickness="0" Background="Transparent"
       Visibility="{Binding IsBrand, Converter={StaticResource VisibleBool}}" ItemContainerStyle="{StaticResource BrandItem}">
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="40" Height="28" BorderBrush="#CCD4CF" BorderThickness="1" CornerRadius="14" Margin="0,0,10,0"><TextBlock Text="{Binding Mark}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding CountLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedReadable}" Margin="5,0,0,0"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Visibility="{Binding IsChildSeat, Converter={StaticResource VisibleBool}}" Margin="10,6">
     <CheckBox Content="Có ghế trẻ em (không yêu cầu độ tuổi)" IsChecked="{Binding AnyChildSeat}" Margin="0,6,0,20"/>
     <TextBlock Text="Độ tuổi" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding Ages}"><ItemsControl.ItemTemplate><DataTemplate>
      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" Margin="0,8"/>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
    <StackPanel Visibility="{Binding IsDelivery, Converter={StaticResource VisibleBool}}" Margin="10,6">
     <TextBlock Text="{Binding PointPrompt}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding DeliveryCityLabel}" Foreground="{StaticResource MutedReadable}" Margin="0,0,0,14"/>
     <ListBox ItemsSource="{Binding DeliveryLocations}" SelectedItem="{Binding SelectedDeliveryLocation}" ItemContainerStyle="{StaticResource BrandItem}" BorderThickness="0" Background="Transparent">
      <ListBox.ItemTemplate><DataTemplate><StackPanel>
       <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding AddressLine}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource MutedReadable}" Margin="0,5,0,0"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
    <StackPanel Visibility="{Binding IsTravel, Converter={StaticResource VisibleBool}}" Margin="10,6">
     <TextBlock Text="Bạn muốn di chuyển tới đâu?" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding DeliveryCityLabel, StringFormat='Điểm nhận xe: {0}'}" Foreground="{StaticResource MutedReadable}" Margin="0,0,0,14"/>
     <ListBox ItemsSource="{Binding TravelDestinations}" SelectedItem="{Binding SelectedDestinationCity}" ItemContainerStyle="{StaticResource BrandItem}" BorderThickness="0" Background="Transparent">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding CityName}" Margin="0,3"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedReadable}" Margin="10,16,10,0">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
