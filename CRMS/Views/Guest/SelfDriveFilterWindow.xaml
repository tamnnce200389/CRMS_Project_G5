<Window x:Class="CRMS.Views.Guest.SelfDriveFilterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="720" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
 Background="{StaticResource CustomerBackground}" Foreground="{StaticResource CustomerInk}" FontSize="14">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleBool"/>
  <Style x:Key="OptionItem" TargetType="ListBoxItem">
   <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Tile" CornerRadius="12" Background="White" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1" Padding="14,12">
     <DockPanel>
      <Border x:Name="Marker" DockPanel.Dock="Right" Width="17" Height="17" Margin="10,0,0,0" VerticalAlignment="Center"
              CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource CustomerMuted}">
       <Path x:Name="Tick" Data="M2,6 L5,9 L11,2" Stroke="White" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Border>
      <ContentPresenter VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource CustomerHover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True">
      <Setter TargetName="Tile" Property="Background" Value="{StaticResource CustomerSoft}"/>
      <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource CustomerInk}"/>
      <Setter TargetName="Marker" Property="Background" Value="{StaticResource CustomerInk}"/>
      <Setter TargetName="Marker" Property="BorderBrush" Value="{StaticResource CustomerInk}"/>
      <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderThickness" Value="2"/><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource CustomerInk}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="{StaticResource CustomerLine}" BorderThickness="1" Background="{StaticResource CustomerBackground}">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{StaticResource CustomerInk}" Padding="22,16">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" Click="Close_Click" Style="{StaticResource StaffSecondaryButton}" MinHeight="32" Padding="12,5"/>
    <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Padding="22,12" BorderThickness="0,1,0,0" BorderBrush="{StaticResource CustomerLine}" Background="White">
   <Button Content="Áp dụng bộ lọc" HorizontalAlignment="Right" Style="{StaticResource StaffButton}" Command="{Binding ApplyCommand}" IsEnabled="{Binding IsReady}"/>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="18,12,18,18">
    <Grid Visibility="{Binding IsPrice, Converter={StaticResource VisibleBool}}" Margin="8">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding PriceUnit, StringFormat='Giá tối thiểu ({0})'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox Text="{Binding PriceFrom, UpdateSourceTrigger=PropertyChanged}" MinHeight="42"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{Binding PriceUnit, StringFormat='Giá tối đa ({0})'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox Text="{Binding PriceTo, UpdateSourceTrigger=PropertyChanged}" MinHeight="42"/></StackPanel>
    </Grid>
    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" BorderThickness="0" Background="Transparent"
       Visibility="{Binding IsChoice, Converter={StaticResource VisibleBool}}" ItemContainerStyle="{StaticResource OptionItem}" Margin="0,5,0,0">
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding ChoiceColumns}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="18"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Visibility="{Binding IsRoute, Converter={StaticResource VisibleBool}}" Margin="10,6">
     <TextBlock Text="Hành trình" Margin="0,0,0,6"/>
     <ComboBox ItemsSource="{Binding RouteOptions}" SelectedItem="{Binding SelectedRoute}"/>
     <TextBlock Text="Điểm đón" Margin="0,16,0,6"/>
     <ComboBox ItemsSource="{Binding RouteCities}" DisplayMemberPath="CityName" SelectedItem="{Binding PickupCity}"/>
     <TextBlock Text="Điểm đến" Margin="0,16,0,6"/>
     <ComboBox ItemsSource="{Binding RouteCities}" DisplayMemberPath="CityName" SelectedItem="{Binding RouteDestination}" IsEnabled="{Binding IsInterCity}"/>
     <TextBlock Text="Thời gian chuyến đi" Margin="0,16,0,6"/>
     <Button Content="{Binding PeriodLabel}" Style="{StaticResource SecondaryButton}" Click="RouteTime_Click"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" BorderThickness="0" Background="Transparent"
       Visibility="{Binding IsCategory, Converter={StaticResource VisibleBool}}" ItemContainerStyle="{StaticResource OptionItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><DockPanel>
      <Grid DockPanel.Dock="Left" Width="92" Height="62" Margin="0,0,12,0">
       <Border CornerRadius="8" Background="{StaticResource CustomerSoft}">
        <Path Data="{Binding BodyGeometry}" Width="48" Height="26" Stretch="Uniform" Stroke="{StaticResource CustomerHover}" StrokeThickness="1.4"/>
       </Border>
      </Grid>
      <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding CountLabel}" Foreground="{StaticResource MutedReadable}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
     </DockPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <ListBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" BorderThickness="0" Background="Transparent"
       Visibility="{Binding IsBrand, Converter={StaticResource VisibleBool}}" ItemContainerStyle="{StaticResource OptionItem}">
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><StackPanel>
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Count, StringFormat={}{0} xe}" FontSize="12" Foreground="{StaticResource MutedReadable}" Margin="0,3,0,0"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Visibility="{Binding IsChildSeat, Converter={StaticResource VisibleBool}}" Margin="10,6">
     <CheckBox Content="Có ghế trẻ em (không yêu cầu độ tuổi)" IsChecked="{Binding AnyChildSeat}" Margin="0,6,0,20"/>
     <TextBlock Text="Độ tuổi" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding Ages}"><ItemsControl.ItemTemplate><DataTemplate>
      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" Margin="0,8"/>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
    <StackPanel Visibility="{Binding IsDelivery, Converter={StaticResource VisibleBool}}" Margin="10,6">
     <TextBlock Text="{Binding PointPrompt}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding DeliveryCityLabel}" Foreground="{StaticResource MutedReadable}" Margin="0,0,0,14"/>
     <ListBox ItemsSource="{Binding DeliveryLocations}" SelectedItem="{Binding SelectedDeliveryLocation}" ItemContainerStyle="{StaticResource OptionItem}" BorderThickness="0" Background="Transparent">
      <ListBox.ItemTemplate><DataTemplate><StackPanel>
       <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding AddressLine}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource MutedReadable}" Margin="0,5,0,0"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
    <StackPanel Visibility="{Binding IsTravel, Converter={StaticResource VisibleBool}}" Margin="10,6">
     <TextBlock Text="Bạn muốn di chuyển tới đâu?" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding DeliveryCityLabel, StringFormat='Điểm nhận xe: {0}'}" Foreground="{StaticResource MutedReadable}" Margin="0,0,0,14"/>
     <ListBox ItemsSource="{Binding TravelDestinations}" SelectedItem="{Binding SelectedDestinationCity}" ItemContainerStyle="{StaticResource OptionItem}" BorderThickness="0" Background="Transparent">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding CityName}" Margin="0,3"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedReadable}" Margin="10,16,10,0">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
 </Border>
</Window>
