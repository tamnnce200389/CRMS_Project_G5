<Window x:Class="CRMS.Views.Guest.RentalTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn thời gian thuê"
        Width="850"
        Height="720"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Surface}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <TextBlock Text="Thời gian"
                       FontSize="25"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button Style="{StaticResource SecondaryButton}" Content="✕"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,22,0"
                    Background="{StaticResource Surface}"
                    Click="Close_Click"/>
        </Grid>

        <!-- RENTAL MODE -->
        <TabControl x:Name="RentalTabs"
                    Style="{StaticResource SegmentedTabControl}"
                    Grid.Row="1"
                    Margin="25,0,25,0"
                    FontSize="15"
                    SelectionChanged="InputChanged">

            <!-- THUE NGAY -->
            <TabItem x:Name="DayTab"
                     Header="Thuê ngày">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <TextBlock Text="Chọn ngày nhận và ngày trả xe"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <!-- 2 lich -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0">

                                <TextBlock Text="Ngày nhận xe"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <Calendar x:Name="PickupCalendar"
                                          SelectionMode="SingleDate"
                                          SelectedDatesChanged="InputChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Ngày trả xe"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <Calendar x:Name="ReturnCalendar"
                                          SelectionMode="SingleDate"
                                          SelectedDatesChanged="InputChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Gio -->
                        <Grid Margin="0,25,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0">

                                <TextBlock Text="Giờ nhận xe"
                                           Margin="0,0,0,8"/>

                                <ComboBox Style="{StaticResource RoundedComboBox}" x:Name="DayPickupTime"
                                          Height="44"
                                          SelectionChanged="InputChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Giờ trả xe"
                                           Margin="0,0,0,8"/>

                                <ComboBox Style="{StaticResource RoundedComboBox}" x:Name="DayReturnTime"
                                          Height="44"
                                          SelectionChanged="InputChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Thời gian thuê ngày tối đa 48 giờ."
                                   Foreground="{StaticResource MutedReadable}"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- THUE GIO -->
            <TabItem x:Name="HourTab"
                     Header="Thuê giờ">

                <StackPanel Margin="20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ngay bat dau -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Ngày bắt đầu"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <DatePicker Style="{StaticResource RoundedDatePicker}" x:Name="HourlyDate"
                                        Height="44"
                                        SelectedDateChanged="InputChanged"/>
                        </StackPanel>

                        <!-- Gio nhan -->
                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Giờ nhận xe"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <ComboBox Style="{StaticResource RoundedComboBox}" x:Name="HourlyPickupTime"
                                      Height="44"
                                      SelectionChanged="InputChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Thoi luong -->
                    <TextBlock Text="Thời gian thuê"
                               FontWeight="SemiBold"
                               Margin="0,28,0,10"/>

                    <ComboBox Style="{StaticResource RoundedComboBox}" x:Name="DurationCombo"
                              Height="44"
                              SelectionChanged="InputChanged">

                        <ComboBoxItem Content="1 giờ" Tag="1"/>
                        <ComboBoxItem Content="2 giờ" Tag="2"/>
                        <ComboBoxItem Content="4 giờ" Tag="4"/>
                        <ComboBoxItem Content="6 giờ" Tag="6"/>
                        <ComboBoxItem Content="8 giờ" Tag="8"/>
                        <ComboBoxItem Content="12 giờ" Tag="12"/>
                        <ComboBoxItem Content="24 giờ" Tag="24"/>
                        <ComboBoxItem Content="48 giờ" Tag="48"/>
                        <ComboBoxItem Content="72 giờ" Tag="72"/>
                    </ComboBox>

                    <TextBlock Text="Ngày kết thúc được tính tự động từ giờ nhận và thời lượng thuê."
                               Foreground="{StaticResource MutedReadable}"
                               TextWrapping="Wrap"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="{StaticResource PageBackground}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0">

            <Grid Margin="25,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SummaryText"
                           Grid.Column="0"
                           Text="Chọn thời gian thuê"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Content="Tiếp tục"
                        Width="130"
                        Height="48"
                        Margin="18,0,0,0"
                        Background="{StaticResource PrimaryHover}"
                        Foreground="{StaticResource Surface}"
                        FontWeight="Bold"
                        FontSize="16"
                        Click="Confirm_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
