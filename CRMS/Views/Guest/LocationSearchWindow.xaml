<Window x:Class="CRMS.Views.Guest.LocationSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tìm kiếm"
        Width="900"
        Height="720"
        MinWidth="720"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Window.Resources>
        <!-- Nut lua chon dang vien -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder"
                                        Property="Background"
                                        Value="#DCFCE7"/>
                                <Setter TargetName="ChipBorder"
                                        Property="BorderBrush"
                                        Value="#22C55E"/>
                                <Setter Property="Foreground"
                                        Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <TextBlock Text="Tìm kiếm"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button Content="✕"
                    Width="38"
                    Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,25,0"
                    Click="Close_Click"/>
        </Grid>

        <!-- FILTER CONTENT -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30,20">

                <!-- CITY -->
                <TextBlock Text="Địa điểm"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <ComboBox x:Name="CityCombo"
                          Height="45"
                          FontSize="15"
                          SelectedIndex="0"
                          Margin="0,0,0,25">

                    <ComboBoxItem Content="Cần Thơ"/>
                    <ComboBoxItem Content="TP. Hồ Chí Minh"/>
                    <ComboBoxItem Content="Hà Nội"/>
                    <ComboBoxItem Content="Đà Nẵng"/>
                </ComboBox>

                <Separator Margin="0,0,0,25"/>

                <!-- NEEDS -->
                <TextBlock Text="Theo nhu cầu"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,18"/>

                <WrapPanel x:Name="NeedsPanel"
                           Margin="0,0,0,18">

                    <ToggleButton Content="Ghế trẻ em"
                                  Tag="ChildSeat"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Di chuyển mở rộng"
                                  Tag="LongDistance"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Lái mới"
                                  Tag="NewDriver"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Công việc, đi lại"
                                  Tag="Business"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Gia đình"
                                  Tag="Family"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Cắm trại, chở đồ"
                                  Tag="Camping"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Nhóm bạn"
                                  Tag="Friends"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Tiếp khách, dự tiệc"
                                  Tag="Event"
                                  Style="{StaticResource FilterChip}"/>
                </WrapPanel>

                <Separator Margin="0,0,0,25"/>

                <!-- TRENDS -->
                <TextBlock Text="Theo xu hướng"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,18"/>

                <WrapPanel x:Name="TrendsPanel"
                           Margin="0,0,0,18">

                    <ToggleButton Content="Xe điện"
                                  Tag="Electric"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Xe hybrid"
                                  Tag="Hybrid"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Xe thể thao"
                                  Tag="Sport"
                                  Style="{StaticResource FilterChip}"/>
                </WrapPanel>

                <Separator Margin="0,0,0,25"/>

                <!-- BUDGET -->
                <TextBlock Text="Theo ngân sách"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,18"/>

                <WrapPanel x:Name="BudgetPanel">

                    <ToggleButton Content="Giá rẻ"
                                  Tag="LowCost"
                                  Style="{StaticResource FilterChip}"/>

                    <ToggleButton Content="Tiết kiệm"
                                  Tag="Economy"
                                  Style="{StaticResource FilterChip}"/>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Background="#F8FAFC">

            <Grid Margin="30,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Chọn địa điểm và bộ lọc phù hợp"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Áp dụng"
                        Width="140"
                        Height="45"
                        Background="#57C985"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="Apply_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
