<Window x:Class="CRMS.Views.Guest.LocationSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Địa điểm và bộ lọc" Width="740" SizeToContent="Height" Language="vi-VN"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        MaxWidth="{Binding Width, Source={x:Static SystemParameters.WorkArea}}"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource CustomerBackground}" Foreground="{StaticResource CustomerInk}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RentalPickerStyles.xaml"/></ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource CustomerBackground}" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource CustomerInk}" Padding="24,17">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" AutomationProperties.Name="Đóng cửa sổ"
                    Style="{StaticResource StaffSecondaryButton}" MinHeight="32" Padding="12,5" VerticalAlignment="Center" Click="Close_Click"/>
                <TextBlock Text="Địa điểm và bộ lọc" FontSize="24" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">
                <Border Style="{StaticResource PickerCard}" Margin="0,0,0,12"><StackPanel>
                    <TextBlock Text="Địa điểm nhận xe" Style="{StaticResource FieldTitle}"/>
                    <ComboBox x:Name="CityCombo" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" Style="{StaticResource RoundedComboBox}" Height="44" DisplayMemberPath="CityName"/>
                </StackPanel></Border>
                <Border Style="{StaticResource PickerCard}"><StackPanel>
                <StackPanel><TextBlock Text="Nhu cầu chuyến đi" Style="{StaticResource FieldTitle}"/>
                    <ItemsControl ItemsSource="{Binding Needs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Label}" Tag="{Binding Code}" IsChecked="{Binding IsSelected}" Style="{StaticResource FilterChoice}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    <Border Margin="0,8,0,14" Height="1" Background="{StaticResource CustomerLine}"/>
                <StackPanel><TextBlock Text="Loại xe yêu thích" Style="{StaticResource FieldTitle}"/>
                    <ItemsControl ItemsSource="{Binding Trends}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Label}" Tag="{Binding Code}" IsChecked="{Binding IsSelected}" Style="{StaticResource FilterChoice}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    <Border Margin="0,8,0,14" Height="1" Background="{StaticResource CustomerLine}"/>
                <StackPanel><TextBlock Text="Ngân sách" Style="{StaticResource FieldTitle}"/>
                    <ItemsControl ItemsSource="{Binding Budgets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Label}" Tag="{Binding Code}" IsChecked="{Binding IsSelected}" Style="{StaticResource FilterChoice}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" Padding="24,14" BorderBrush="{StaticResource CustomerLine}" BorderThickness="0,1,0,0">
            <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Đặt lại" Style="{StaticResource StaffSecondaryButton}" Command="{Binding ResetCommand}" Margin="0,0,8,0"/><Button x:Name="ApplyButton" Content="Áp dụng bộ lọc" Style="{StaticResource StaffButton}" Command="{Binding ApplyCommand}"/></StackPanel>
                <TextBlock x:Name="LocationStatus" Text="{Binding Status}" Margin="0,0,14,0" Foreground="{StaticResource CustomerInk}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid></Border>
</Window>