<Page x:Class="CRMS.Views.Admin.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tổng quan quản trị"
      Background="{StaticResource PageBackground}"
      FontFamily="Segoe UI">

    <Page.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="AdminCard"
               TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="{StaticResource ShadowColor}"/>
                </Setter.Value>
            </Setter></Style>

        <Style x:Key="AdminKpiCard"
               TargetType="Border"
               BasedOn="{StaticResource AdminCard}">
            <Setter Property="Width" Value="215"/>
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style BasedOn="{StaticResource {x:Type Button}}" x:Key="AdminButton"
               TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30,27,30,36">

            <!-- HEADER -->

            <TextBlock Text="Tổng quan quản trị"
                       FontSize="29"
                       FontWeight="Bold"
                       Foreground="{StaticResource Ink}"/>

            <TextBlock
                Text="Theo dõi hoạt động cho thuê xe, tình trạng phương tiện và dòng tiền của CRMS."
                FontSize="14"
                Foreground="{StaticResource MutedReadable}"
                Margin="0,8,0,25"
                TextWrapping="Wrap"/>

            <!-- ADMIN BANNER -->

            <Border CornerRadius="18"
                    Padding="30"
                    Margin="0,0,0,28">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryPressedColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel>

                    <TextBlock Text="ADMIN WORKSPACE"
                               Foreground="{StaticResource HeroText}"
                               FontSize="12"
                               FontWeight="Bold"/>

                    <TextBlock
                        Text="Chào mừng đến với CRMS!"
                        Foreground="{StaticResource Surface}"
                        FontSize="29"
                        FontWeight="Bold"
                        Margin="0,12,0,10"/>

                    <TextBlock
                        Text="Quản lý và theo dõi hoạt động kinh doanh thông qua dữ liệu thực tế từ SQL Server."
                        Foreground="{StaticResource HeroText}"
                        FontSize="14"
                        TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- DATE FILTER -->

            <Border Style="{StaticResource AdminCard}"
                    Margin="0,0,0,28">

                <StackPanel>

                    <TextBlock Text="Bộ lọc thống kê"
                               Style="{StaticResource SectionTitle}"/>

                    <WrapPanel Margin="0,0,0,12">

                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="Từ ngày"
                                       Foreground="{StaticResource MutedReadable}"
                                       Margin="0,0,0,6"/>

                            <DatePicker Style="{StaticResource RoundedDatePicker}" Width="180"
                                        SelectedDate="{Binding FromDate, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="Đến ngày"
                                       Foreground="{StaticResource MutedReadable}"
                                       Margin="0,0,0,6"/>

                            <DatePicker Style="{StaticResource RoundedDatePicker}" Width="180"
                                        SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                        </StackPanel>

                        <Button Content="Cập nhật thống kê"
                                Style="{StaticResource AdminButton}"
                                Command="{Binding RefreshCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,12"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedReadable}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ADMIN DATA -->

            <StackPanel Visibility="{Binding HasData,
                         Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="Chỉ số tổng quan"
                           Style="{StaticResource SectionTitle}"/>

                <!-- KPI CARDS -->

                <WrapPanel Margin="0,0,0,15">

                    <Border Style="{StaticResource AdminKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Tổng đơn thuê"
                                       Foreground="{StaticResource MutedReadable}"/>
                            <TextBlock
                                Text="{Binding Snapshot.TotalBookings}"
                                Foreground="{StaticResource PrimaryHover}"
                                FontWeight="Bold"
                                FontSize="30"
                                Margin="0,11,0,5"/>
                            <TextBlock Text="Theo ngày tạo đơn"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AdminKpiCard}"
                            Background="{StaticResource PrimarySoft}">
                        <StackPanel>
                            <TextBlock Text="Tiền thực thu"
                                       Foreground="{StaticResource MutedReadable}"/>
                            <TextBlock
                                Text="{Binding Snapshot.NetCashCollected, StringFormat='{}{0:N0} đ'}"
                                Foreground="{StaticResource PrimaryHover}"
                                FontWeight="Bold"
                                FontSize="24"
                                Margin="0,11,0,5"/>
                            <TextBlock Text="Thu trừ hoàn"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AdminKpiCard}"
                            Background="{StaticResource HighlightSoft}">
                        <StackPanel>
                            <TextBlock Text="Xe đang thuê"
                                       Foreground="{StaticResource MutedReadable}"/>
                            <TextBlock
                                Text="{Binding Snapshot.VehiclesInUse}"
                                Foreground="{StaticResource HighlightInk}"
                                FontWeight="Bold"
                                FontSize="30"
                                Margin="0,11,0,5"/>
                            <TextBlock Text="Trạng thái hiện tại"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AdminKpiCard}"
                            Background="{StaticResource DangerSoft}">
                        <StackPanel>
                            <TextBlock Text="Xe đang bảo trì"
                                       Foreground="{StaticResource MutedReadable}"/>
                            <TextBlock
                                Text="{Binding Snapshot.VehiclesInMaintenance}"
                                Foreground="{StaticResource Danger}"
                                FontWeight="Bold"
                                FontSize="30"
                                Margin="0,11,0,5"/>
                            <TextBlock Text="Lịch bảo trì hiện tại"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AdminKpiCard}"
                            Background="{StaticResource PrimarySoft}">
                        <StackPanel>
                            <TextBlock Text="Tổng số xe"
                                       Foreground="{StaticResource MutedReadable}"/>
                            <TextBlock
                                Text="{Binding Snapshot.TotalVehicles}"
                                Foreground="{StaticResource Ink}"
                                FontWeight="Bold"
                                FontSize="30"
                                Margin="0,11,0,5"/>
                            <TextBlock Text="Toàn bộ hệ thống"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- BOOKING STATUS -->

                <Border Style="{StaticResource AdminCard}"
                        Margin="0,0,0,24">

                    <StackPanel>

                        <TextBlock Text="Thống kê trạng thái Booking"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock
                            Text="Số đơn được tạo trong khoảng thời gian đã chọn."
                            Foreground="{StaticResource MutedReadable}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,16"/>

                        <UniformGrid Columns="2">

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,9">
                                <TextBlock Text="Chờ cọc: " Width="145"/>
                                <TextBlock Text="{Binding Snapshot.PendingDeposit}"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,9">
                                <TextBlock Text="Đã xác nhận: " Width="145"/>
                                <TextBlock Text="{Binding Snapshot.Confirmed}"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,9">
                                <TextBlock Text="Đang thuê: " Width="145"/>
                                <TextBlock Text="{Binding Snapshot.InUse}"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,9">
                                <TextBlock Text="Đã trả xe: " Width="145"/>
                                <TextBlock Text="{Binding Snapshot.Returned}"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,9">
                                <TextBlock Text="Hoàn tất: " Width="145"/>
                                <TextBlock Text="{Binding Snapshot.Completed}"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,9">
                                <TextBlock Text="Đã hủy: " Width="145"/>
                                <TextBlock Text="{Binding Snapshot.Cancelled}"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,9">
                                <TextBlock Text="Hết hạn: " Width="145"/>
                                <TextBlock Text="{Binding Snapshot.Expired}"
                                           FontWeight="Bold"/>
                            </StackPanel>

                        </UniformGrid>

                    </StackPanel>
                </Border>

                <!-- PAYMENT STATISTICS -->

                <Border Style="{StaticResource AdminCard}"
                        Margin="0,0,0,24">

                    <StackPanel>

                        <TextBlock Text="Tổng hợp dòng tiền"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock
                            Text="Chỉ tính giao dịch Success theo ngày thanh toán; tiền hoàn được trừ khỏi tổng thu."
                            Foreground="{StaticResource MutedReadable}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="54"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Tiền cọc đã thu"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Snapshot.DepositCollected, StringFormat='{}{0:N0} đ'}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                                       Text="Tiền còn lại đã thu"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Snapshot.BalanceCollected, StringFormat='{}{0:N0} đ'}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Text="Tiền đã hoàn"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding Snapshot.RefundedAmount, StringFormat='{}{0:N0} đ'}"
                                       Foreground="{StaticResource Danger}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Background="{StaticResource PrimarySoft}"
                                    CornerRadius="10"
                                    Padding="12">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="TỔNG TIỀN THỰC THU"
                                               Foreground="{StaticResource Ink}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Snapshot.NetCashCollected, StringFormat='{}{0:N0} đ'}"
                                               Foreground="{StaticResource PrimaryPressed}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- QUICK ACTIONS -->

            <TextBlock Text="Truy cập nhanh"
                       Style="{StaticResource SectionTitle}"/>

            <WrapPanel>

                <Button Content="Quản lý xe"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,12"
                        Command="{Binding DataContext.NavigateCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Vehicles"/>

                <Button Content="Quản lý đơn thuê"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,12"
                        Command="{Binding DataContext.NavigateCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Bookings"/>

                <Button Content="Quản lý tài xế"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,12"
                        Command="{Binding DataContext.NavigateCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Drivers"/>

                <Button Content="Báo cáo doanh thu"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,12"
                        Command="{Binding DataContext.NavigateCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Reports"/>

            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
