<Page x:Class="CRMS.Views.Admin.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Báo cáo doanh thu"
      Background="#F4F7FC"
      FontFamily="Segoe UI">

    <Page.Resources>

        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility"/>

        <!-- CARD STYLE -->
        <Style x:Key="ReportCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- KPI CARD -->
        <Style x:Key="KpiCard"
               TargetType="Border"
               BasedOn="{StaticResource ReportCard}">
            <Setter Property="Width" Value="225"/>
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <!-- SECTION TITLE -->
        <Style x:Key="SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#183A72"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- BUTTON -->
        <Style x:Key="ReportButton"
               TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30,27,30,36">

            <!-- ======================== -->
            <!-- HEADER -->
            <!-- ======================== -->

            <TextBlock Text="Báo cáo doanh thu"
                       FontSize="29"
                       FontWeight="Bold"
                       Foreground="#102A56"/>

            <TextBlock
                Text="Theo dõi các khoản thanh toán, hoàn tiền và xuất báo cáo doanh thu."
                Foreground="#64748B"
                FontSize="14"
                TextWrapping="Wrap"
                Margin="0,8,0,24"/>

            <!-- ======================== -->
            <!-- BANNER -->
            <!-- ======================== -->

            <Border CornerRadius="18"
                    Padding="28"
                    Margin="0,0,0,24">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#183A72"
                                      Offset="0"/>
                        <GradientStop Color="#2563EB"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel>

                    <TextBlock Text="REVENUE REPORT"
                               Foreground="#BFDBFE"
                               FontSize="12"
                               FontWeight="Bold"/>

                    <TextBlock Text="Phân tích dòng tiền kinh doanh"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="Bold"
                               Margin="0,12,0,10"/>

                    <TextBlock
                        Text="Báo cáo dựa trên giao dịch thành công, không cộng các khoản chưa được thanh toán."
                        Foreground="#DBEAFE"
                        FontSize="14"
                        TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- ======================== -->
            <!-- FILTER -->
            <!-- ======================== -->

            <Border Style="{StaticResource ReportCard}"
                    Margin="0,0,0,24">

                <StackPanel>

                    <TextBlock Text="Bộ lọc báo cáo"
                               Style="{StaticResource SectionTitle}"/>

                    <WrapPanel Margin="0,0,0,12">

                        <!-- FROM DATE -->
                        <StackPanel Margin="0,0,16,12">

                            <TextBlock Text="Từ ngày"
                                       Foreground="#64748B"
                                       Margin="0,0,0,6"/>

                            <DatePicker Width="180"
                                        SelectedDate="{Binding FromDate, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- TO DATE -->
                        <StackPanel Margin="0,0,16,12">

                            <TextBlock Text="Đến ngày"
                                       Foreground="#64748B"
                                       Margin="0,0,0,6"/>

                            <DatePicker Width="180"
                                        SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- FILTER BUTTON -->
                        <Button Content="Xem báo cáo"
                                Style="{StaticResource ReportButton}"
                                Command="{Binding FilterByDateCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,12,12"/>

                        <!-- EXPORT BUTTON -->
                        <Button Content="Xuất CSV"
                                Style="{StaticResource ReportButton}"
                                Background="#059669"
                                Command="{Binding ExportCsvCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,12"/>

                    </WrapPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- ======================== -->
            <!-- REPORT RESULTS -->
            <!-- ======================== -->

            <StackPanel Visibility="{Binding HasData,
                        Converter={StaticResource BoolToVisibility}}">

                <!-- SUMMARY -->

                <TextBlock Text="Tổng quan doanh thu"
                           Style="{StaticResource SectionTitle}"/>

                <WrapPanel Margin="0,0,0,14">

                    <!-- TOTAL BOOKINGS -->
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>

                            <TextBlock Text="Đơn có thanh toán"
                                       Foreground="#64748B"/>

                            <TextBlock
                                Text="{Binding Report.TotalBookings}"
                                Foreground="#2563EB"
                                FontWeight="Bold"
                                FontSize="30"
                                Margin="0,10,0,5"/>

                            <TextBlock Text="Trong khoảng ngày"
                                       Foreground="#94A3B8"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- TOTAL TRANSACTIONS -->
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>

                            <TextBlock Text="Giao dịch thành công"
                                       Foreground="#64748B"/>

                            <TextBlock
                                Text="{Binding Report.TotalTransactions}"
                                Foreground="#183A72"
                                FontWeight="Bold"
                                FontSize="30"
                                Margin="0,10,0,5"/>

                            <TextBlock Text="Deposit, Balance, Refund"
                                       Foreground="#94A3B8"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- TOTAL DEPOSITS -->
                    <Border Style="{StaticResource KpiCard}"
                            Background="#EFF6FF">
                        <StackPanel>

                            <TextBlock Text="Tiền cọc đã thu"
                                       Foreground="#64748B"/>

                            <TextBlock
                                Text="{Binding Report.TotalDeposits, StringFormat='{}{0:N0} đ'}"
                                Foreground="#2563EB"
                                FontWeight="Bold"
                                FontSize="24"
                                Margin="0,12,0,5"/>

                            <TextBlock Text="Deposit thành công"
                                       Foreground="#94A3B8"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- TOTAL BALANCE -->
                    <Border Style="{StaticResource KpiCard}"
                            Background="#F0FDF4">
                        <StackPanel>

                            <TextBlock Text="Tiền còn lại đã thu"
                                       Foreground="#64748B"/>

                            <TextBlock
                                Text="{Binding Report.TotalBalances, StringFormat='{}{0:N0} đ'}"
                                Foreground="#059669"
                                FontWeight="Bold"
                                FontSize="24"
                                Margin="0,12,0,5"/>

                            <TextBlock Text="Balance thành công"
                                       Foreground="#94A3B8"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- TOTAL REFUND -->
                    <Border Style="{StaticResource KpiCard}"
                            Background="#FEF2F2">
                        <StackPanel>

                            <TextBlock Text="Tiền đã hoàn"
                                       Foreground="#64748B"/>

                            <TextBlock
                                Text="{Binding Report.TotalRefunds, StringFormat='{}{0:N0} đ'}"
                                Foreground="#DC2626"
                                FontWeight="Bold"
                                FontSize="24"
                                Margin="0,12,0,5"/>

                            <TextBlock Text="Refund thành công"
                                       Foreground="#94A3B8"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- NET REVENUE -->

                <Border Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,0,24">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="TỔNG TIỀN THỰC THU"
                                       FontWeight="Bold"
                                       Foreground="#183A72"
                                       FontSize="15"/>

                            <TextBlock
                                Text="Tiền cọc + tiền còn lại - tiền đã hoàn"
                                Foreground="#64748B"
                                FontSize="12"
                                Margin="0,6,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Report.NetRevenue, StringFormat='{}{0:N0} đ'}"
                                   Foreground="#1D4ED8"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0"/>

                    </Grid>
                </Border>

                <!-- ======================== -->
                <!-- DETAILS DATA GRID -->
                <!-- ======================== -->

                <Border Style="{StaticResource ReportCard}"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Chi tiết giao dịch theo đơn thuê"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock
                            Text="Mỗi dòng là một Booking có giao dịch thành công trong khoảng thời gian đã chọn. Đơn vị tiền: VND."
                            Foreground="#64748B"
                            TextWrapping="Wrap"
                            Margin="0,0,0,16"/>

                        <DataGrid
                            ItemsSource="{Binding Rows}"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            IsReadOnly="True"
                            SelectionMode="Single"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            RowHeight="38"
                            ColumnHeaderHeight="42"
                            Height="390"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            AlternatingRowBackground="#F8FAFC">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Mã đơn"
                                    Binding="{Binding BookingCode}"
                                    Width="190"/>

                                <DataGridTextColumn
                                    Header="Xe"
                                    Binding="{Binding VehicleName}"
                                    Width="160"/>

                                <DataGridTextColumn
                                    Header="Biển số"
                                    Binding="{Binding LicensePlate}"
                                    Width="120"/>

                                <DataGridTextColumn
                                    Header="Trạng thái đơn"
                                    Binding="{Binding BookingStatus}"
                                    Width="130"/>

                                <DataGridTextColumn
                                    Header="Giá trị đơn"
                                    Binding="{Binding BookingTotal, StringFormat=N0}"
                                    Width="120"/>

                                <DataGridTextColumn
                                    Header="Cọc đã thu"
                                    Binding="{Binding DepositPaid, StringFormat=N0}"
                                    Width="120"/>

                                <DataGridTextColumn
                                    Header="Còn lại đã thu"
                                    Binding="{Binding BalancePaid, StringFormat=N0}"
                                    Width="125"/>

                                <DataGridTextColumn
                                    Header="Đã hoàn"
                                    Binding="{Binding RefundPaid, StringFormat=N0}"
                                    Width="120"/>

                                <DataGridTextColumn
                                    Header="Thực thu ròng"
                                    Binding="{Binding NetCollected, StringFormat=N0}"
                                    Width="135"/>

                                <DataGridTextColumn
                                    Header="Số GD"
                                    Binding="{Binding TransactionCount}"
                                    Width="75"/>

                                <DataGridTextColumn
                                    Header="Giao dịch gần nhất"
                                    Binding="{Binding LastPaymentAtVN, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                    Width="155"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- NO TRANSACTIONS -->

                        <TextBlock
                            Text="Không có giao dịch thành công trong khoảng thời gian này."
                            Foreground="#64748B"
                            TextAlignment="Center"
                            Margin="0,15,0,0"
                            Visibility="{Binding HasNoTransactions,
                                Converter={StaticResource BoolToVisibility}}"/>

                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ======================== -->
            <!-- BOTTOM ACTION -->
            <!-- ======================== -->

            <Button Content="Về Dashboard"
                    Style="{StaticResource ReportButton}"
                    Background="#475569"
                    HorizontalAlignment="Left"
                    Command="{Binding DataContext.NavigateCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Dashboard"/>

        </StackPanel>

    </ScrollViewer>
</Page>
