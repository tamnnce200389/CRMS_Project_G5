<Window x:Class="CRMS.Views.Admin.VoucherEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm / Sửa Voucher"
        Width="620"
        Height="750"
        MinWidth="550"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource PageBackground}"
        FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tieu de -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="txtTitle"
                       Text="Thông tin Voucher"
                       FontSize="25"
                       FontWeight="Bold"/>

            <TextBlock Text="Nhập thông tin chương trình giảm giá."
                       Foreground="{StaticResource MutedReadable}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Form nhap lieu -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,12,0">

                <TextBlock Text="Mã Voucher *"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="txtVoucherCode"
                         Height="36"
                         Margin="0,6,0,15"
                         MaxLength="40"/>

                <TextBlock Text="Loại giảm giá *"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="cboDiscountType"
                          Height="36"
                          Margin="0,6,0,15"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Percent"/>
                    <ComboBoxItem Content="Fixed"/>
                </ComboBox>

                <TextBlock Text="Giá trị giảm *"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="txtDiscountValue"
                         Height="36"
                         Margin="0,6,0,15"/>

                <TextBlock Text="Mức giảm tối đa (không bắt buộc)"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="txtMaxDiscount"
                         Height="36"
                         Margin="0,6,0,15"/>

                <TextBlock Text="Giá trị đơn hàng tối thiểu *"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="txtMinimumOrder"
                         Height="36"
                         Margin="0,6,0,15"/>

                <TextBlock Text="Ngày bắt đầu *"
                           FontWeight="SemiBold"/>
                <DatePicker x:Name="dpStartsAt"
                            Height="36"
                            Margin="0,6,0,15"/>

                <TextBlock Text="Ngày kết thúc *"
                           FontWeight="SemiBold"/>
                <DatePicker x:Name="dpEndsAt"
                            Height="36"
                            Margin="0,6,0,15"/>

                <TextBlock Text="Tổng lượt sử dụng tối đa (không bắt buộc)"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="txtUsageLimit"
                         Height="36"
                         Margin="0,6,0,15"/>

                <TextBlock Text="Giới hạn mỗi khách *"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="txtPerCustomerLimit"
                         Height="36"
                         Margin="0,6,0,15"
                         Text="1"/>

                <CheckBox x:Name="chkIsActive"
                          Content="Voucher đang hoạt động"
                          IsChecked="True"
                          Margin="0,8,0,15"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Nut thao tac -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Hủy"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button x:Name="btnSave"
                    Content="Lưu Voucher"
                    Width="130"
                    Height="38"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
