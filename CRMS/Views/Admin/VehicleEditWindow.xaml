<Window x:Class="CRMS.Views.Admin.VehicleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="735"
        MinWidth="880"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CustomerBackground}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AdminButtonBase}"/>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource AdminCell}"/>
    </Window.Resources>


    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding WindowTitle}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Nhập đầy đủ các thông số bắt buộc (*). Mỗi xe có thể gắn nhiều ảnh và chọn 1 ảnh làm ảnh chính."
                       Style="{StaticResource Subtitle}"
                       FontSize="12"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- MAIN 2-COLUMN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: VEHICLE FORM -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Category & License Plate -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,14">
                            <TextBlock Text="Loại xe *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedValuePath="CategoryId"
                                      DisplayMemberPath="CategoryName"
                                      SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}"
                                      Height="38" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,14">
                            <TextBlock Text="Biển số xe *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="20"
                                     Height="38" />
                        </StackPanel>

                        <!-- Row 1: Brand & Model -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,14">
                            <TextBlock Text="Hãng xe *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="80"
                                     Height="38" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,14">
                            <TextBlock Text="Mẫu xe *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Height="38" />
                        </StackPanel>

                        <!-- Row 2: Year & Seats -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,14">
                            <TextBlock Text="Năm sản xuất (1990 - 2100) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding ManufactureYearText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="4"
                                     Height="38" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,14">
                            <TextBlock Text="Số chỗ ngồi (1 - 30) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding SeatCountText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2"
                                     Height="38" />
                        </StackPanel>

                        <!-- Row 3: Transmission & Fuel -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,14">
                            <TextBlock Text="Hộp số *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding TransmissionOptions}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding SelectedTransmission, Mode=TwoWay}"
                                      Height="38" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,14">
                            <TextBlock Text="Nhiên liệu *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding FuelOptions}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding SelectedFuelType, Mode=TwoWay}"
                                      Height="38" />
                        </StackPanel>

                        <!-- Row 4: DailyRate & Odometer -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,14">
                            <TextBlock Text="Giá thuê / ngày (VNĐ) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding DailyRateText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,14">
                            <TextBlock Text="Công-tơ-mét (km) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding OdometerKmText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38" />
                        </StackPanel>

                        <!-- Row 5: Status -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="Trạng thái khai thác *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding SelectedOperationalStatus, Mode=TwoWay}"
                                      Height="38" />
                        </StackPanel>

                        <!-- Row 6: Description -->
                        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="Mô tả chi tiết" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2000"
                                     MinHeight="64"
                                     Padding="10,8"
                                     VerticalContentAlignment="Top"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: VEHICLE IMAGES -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="165" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right"
                                Content="Chọn ảnh từ máy…"
                                Command="{Binding BrowseLocalImagesCommand}"
                                Background="{StaticResource CustomerSoft}"
                                Foreground="{StaticResource CustomerInk}"
                                BorderBrush="{StaticResource CustomerLine}"
                                BorderThickness="1"
                                Padding="12,7"
                                FontSize="12" />
                        <TextBlock Text="Bộ ảnh phương tiện" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Preview -->
                    <Border Grid.Row="1"
                            Background="{StaticResource CustomerBackground}"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Xem trước ảnh xe"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding PreviewImageUrl}"
                                   Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <!-- Add URL Row -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,8,0">
                            <TextBox Height="36"
                                     Text="{Binding AddUrlInput, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Hoặc dán URL ảnh (https://...)"
                                       Margin="12,0"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AddUrlInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1"
                                Content="+ Thêm URL"
                                Command="{Binding AddImageUrlCommand}"
                                Padding="12,7"
                                FontSize="12" />
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Text="Danh sách ảnh (chọn 1 ảnh làm ảnh chính)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6" />

                    <!-- Image List -->
                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding Images}"
                             SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"
                             Background="#FAFCFF"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,6" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{StaticResource CustomerSoft}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="ẢNH CHÍNH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CustomerInk}" />
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="150" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ImageUrl}"
                                                       Foreground="#94A3B8"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="195"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Chính"
                                                    Command="{Binding DataContext.SetPrimaryImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Background="White"
                                                    Foreground="{StaticResource CustomerInk}"
                                                    BorderBrush="{StaticResource CustomerLine}"
                                                    BorderThickness="1"
                                                    Padding="7,4"
                                                    FontSize="11"
                                                    Margin="0,0,4,0" />
                                            <Button Content="▲"
                                                    Command="{Binding DataContext.MoveImageUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Background="White"
                                                    Foreground="#475569"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    Padding="6,4"
                                                    FontSize="10"
                                                    Margin="0,0,3,0" />
                                            <Button Content="▼"
                                                    Command="{Binding DataContext.MoveImageDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Background="White"
                                                    Foreground="#475569"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    Padding="6,4"
                                                    FontSize="10"
                                                    Margin="0,0,4,0" />
                                            <Button Content="✕"
                                                    Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#FEF2F2"
                                                    Foreground="#DC2626"
                                                    BorderBrush="#FECACA"
                                                    BorderThickness="1"
                                                    Padding="7,4"
                                                    FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12,8"
                    Margin="0,0,16,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Hủy"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Background="White"
                        Foreground="#334155"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Padding="20,10"
                        Margin="0,0,10,0" />

                <Button Content="Lưu thông tin xe"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"
                        Padding="22,10" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
