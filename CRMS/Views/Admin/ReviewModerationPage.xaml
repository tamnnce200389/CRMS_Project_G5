<Page x:Class="CRMS.Views.Admin.ReviewModerationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Kiểm duyệt đánh giá"
      Background="{StaticResource PageBackground}">

    <Page.Resources>

        <!-- Style rieng cho nut Duyet va An -->
        <Style x:Key="ModerationActionButton"
               TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="False"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="KIỂM DUYỆT ĐÁNH GIÁ"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#172B4D"/>

                <TextBlock
                    Text="Quản lý các đánh giá của khách hàng."
                    Margin="0,7,0,0"
                    FontSize="13"
                    Foreground="#64748B"/>

            </StackPanel>

            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Content="Làm mới"
                    Width="110"
                    Height="38"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Refresh_Click"/>

        </Grid>

        <!-- STATUS -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,15">

            <TextBlock x:Name="StatusTextBlock"
                       Text="Chưa tải danh sách đánh giá."
                       FontSize="13"
                       Foreground="#475569"
                       TextWrapping="Wrap"/>

        </Border>

        <!-- REVIEW LIST -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="14">

            <DataGrid x:Name="ReviewsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="54"
                      ColumnHeaderHeight="44"
                      BorderThickness="0"
                      Background="White"
                      AlternatingRowBackground="#F8FAFC"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalContentAlignment="Center">

                <DataGrid.Columns>

                    <!-- REVIEW ID -->
                    <DataGridTextColumn
                        Header="Mã đánh giá"
                        Binding="{Binding ReviewId}"
                        Width="105"/>

                    <!-- BOOKING ID -->
                    <DataGridTextColumn
                        Header="Mã đơn thuê"
                        Binding="{Binding BookingId}"
                        Width="105"/>

                    <!-- RATING -->
                    <DataGridTextColumn
                        Header="Số sao"
                        Binding="{Binding Rating}"
                        Width="75"/>

                    <!-- COMMENT -->
                    <DataGridTextColumn
                        Header="Nội dung đánh giá"
                        Binding="{Binding Comment}"
                        Width="*"/>

                    <!-- CREATED DATE -->
                    <DataGridTextColumn
                        Header="Ngày đánh giá"
                        Binding="{Binding CreatedAt,
                                  StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                        Width="145"/>

                    <!-- STATUS -->
                    <DataGridTemplateColumn
                        Header="Trạng thái"
                        Width="120">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Text"
                                                    Value="Chờ duyệt / Ẩn"/>

                                            <Setter Property="Foreground"
                                                    Value="#D97706"/>

                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding IsVisible}"
                                                    Value="True">

                                                    <Setter Property="Text"
                                                            Value="Đã hiển thị"/>

                                                    <Setter Property="Foreground"
                                                            Value="#16A34A"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <!-- ACTION BUTTONS -->
                    <DataGridTemplateColumn
                        Header="Thao tác"
                        Width="190">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <!-- APPROVE -->
                                    <Button
                                        Content="Duyệt"
                                        Style="{StaticResource ModerationActionButton}"
                                        Background="#16A34A"
                                        Margin="0,0,8,0"
                                        Tag="{Binding}"
                                        Click="Approve_Click"/>

                                    <!-- HIDE -->
                                    <Button
                                        Content="Ẩn"
                                        Style="{StaticResource ModerationActionButton}"
                                        Background="#DC2626"
                                        Tag="{Binding}"
                                        Click="Hide_Click"/>

                                </StackPanel>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>
