<Window x:Class="CRMS.Views.Admin.CategoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý danh mục loại xe"
        Width="900"
        Height="560"
        MinWidth="780"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CustomerBackground}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AdminButtonBase}"/>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource AdminCell}"/>
    </Window.Resources>


    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="Đóng"
                    Command="{Binding CloseCommand}"
                    IsCancel="True"
                    Background="White"
                    Foreground="#334155"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Padding="18,9"
                    VerticalAlignment="Center" />

            <StackPanel>
                <TextBlock Text="Danh mục loại xe" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Quản lý phân khúc phương tiện (Sedan, SUV, MPV…). Chỉ có thể ngừng loại xe khi không còn xe đang hoạt động."
                           Style="{StaticResource Subtitle}"
                           FontSize="12"
                           Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: CATEGORY TABLE -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0" ClipToBounds="True">
                <Grid Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="16,13">
                        <TextBlock Text="Tất cả loại xe" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Chọn một dòng để chỉnh sửa"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   HorizontalAlignment="Right" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              RowHeight="48">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ" Binding="{Binding CategoryId}" Width="58" />
                            <DataGridTextColumn Header="TÊN LOẠI XE" Binding="{Binding CategoryName}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="XE HOẠT ĐỘNG" Binding="{Binding ActiveVehicles}" Width="115" />
                            <DataGridTemplateColumn Header="TRẠNG THÁI" SortMemberPath="IsActive" Width="128">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="8,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource CustomerSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Ngừng hoạt động" />
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Hoạt động" />
                                                                <Setter Property="Foreground" Value="{StaticResource CustomerInk}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT: CATEGORY FORM -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />

                        <TextBlock Text="Tên loại xe *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80"
                                 Height="38"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="Mô tả" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="500"
                                 MinHeight="78"
                                 Padding="10,8"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,14" />

                        <CheckBox Content="Loại xe đang hoạt động"
                                  IsChecked="{Binding IsActive, Mode=TwoWay}"
                                  Margin="0,0,0,16" />

                        <Border Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,14"
                                Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#B91C1C"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Button Content="Lưu loại xe"
                                Command="{Binding SaveCommand}"
                                Padding="12,10"
                                Margin="0,0,0,8" />

                        <Button Content="Ngừng / Kích hoạt loại xe"
                                Command="{Binding ToggleActiveCommand}"
                                Background="{StaticResource CustomerSoft}"
                                Foreground="{StaticResource CustomerInk}"
                                BorderBrush="{StaticResource CustomerLine}"
                                BorderThickness="1"
                                Padding="12,9"
                                Margin="0,0,0,8" />

                        <Button Content="Nhập mới / Xóa form"
                                Command="{Binding NewCommand}"
                                Background="White"
                                Foreground="#334155"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Padding="12,9" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource Subtitle}"
                   FontSize="11"
                   Margin="2,10,0,0" />
    </Grid>
</Window>
