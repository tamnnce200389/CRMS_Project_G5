<Page x:Class="CRMS.Views.Admin.AvailabilityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vehicles="clr-namespace:CRMS.Services.Vehicles"
      Title="Kiểm tra lịch trống phương tiện">
    <Page.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AdminButtonBase}"/>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource AdminCell}"/>
    </Page.Resources>

    <Grid Margin="30,22">
        <Grid.Resources>
            <Style x:Key="CompactDatePicker" TargetType="DatePicker">
                <Setter Property="Height" Value="38" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#DCE3ED" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <DataTemplate x:Key="SelectedResultTemplate" DataType="{x:Type vehicles:VehicleAvailabilityResult}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Vehicle Summary Header -->
                <StackPanel Margin="0,0,0,14">
                    <DockPanel LastChildFill="False">
                        <Border Background="{StaticResource CustomerSoft}" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding LicensePlate}"
                                       Foreground="{StaticResource CustomerInk}"
                                       FontWeight="Bold"
                                       FontSize="12" />
                        </Border>

                        <Border DockPanel.Dock="Right" CornerRadius="6" Padding="10,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEE2E2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CustomerSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding AvailabilityLabel}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource CustomerInk}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,10,0,3" />

                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
                        <Run Text="{Binding CategoryName, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding SeatCount, Mode=OneWay}" />
                        <Run Text=" chỗ · " />
                        <Run Text="{Binding DailyRate, StringFormat={}{0:N0} VNĐ/ngày, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Checked Half-Open Interval Box -->
                <Border Grid.Row="1"
                        Background="{StaticResource CustomerBackground}"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="KHUNG GIỜ ĐỐI CHIẾU [NHẬN XE, TRẢ XE)"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding PeriodText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Conflict Details OR Available Confirmation -->
                <Grid Grid.Row="2">
                    <!-- Available Box -->
                    <Border Background="{StaticResource CustomerSoft}"
                            BorderBrush="{StaticResource CustomerLine}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14"
                            VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="✓  Phương tiện sẵn sàng cho thuê"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CustomerInk}" />
                            <TextBlock Text="Không có đơn thuê (Đang sử dụng / Đã xác nhận / Giữ chỗ chờ cọc) hoặc lịch bảo trì nào giao với khoảng giờ đã chọn."
                                       Foreground="{StaticResource CustomerInk}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Conflicts List -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding ConflictCount, StringFormat=Nguyên nhân không khả dụng ({0}):}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#991B1B"
                                   Margin="0,0,0,8" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Conflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vehicles:AvailabilityConflict}">
                                        <Border Background="#FFF8F8"
                                                BorderBrush="#FECACA"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right"
                                                            Background="#FEE2E2"
                                                            CornerRadius="4"
                                                            Padding="7,2"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding HasReferenceCode, Converter={StaticResource BoolVisibility}}">
                                                        <TextBlock Text="{Binding ReferenceCode}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#991B1B" />
                                                    </Border>

                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#991B1B"
                                                               TextWrapping="Wrap" />
                                                </DockPanel>

                                                <TextBlock Text="{Binding Reason}"
                                                           FontSize="12"
                                                           Foreground="#334155"
                                                           TextWrapping="Wrap"
                                                           LineHeight="18"
                                                           Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <DockPanel Margin="0,0,0,16" LastChildFill="True">
            <Border DockPanel.Dock="Right"
                    Background="{StaticResource CustomerSoft}"
                    BorderBrush="{StaticResource CustomerLine}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <TextBlock Text="Quy tắc khoảng nửa mở [Nhận xe, Trả xe) · Trả lúc 12:00 cho phép đơn kế tiếp nhận lúc 12:00"
                           Foreground="{StaticResource CustomerInk}"
                           FontSize="11.5"
                           FontWeight="SemiBold" />
            </Border>

            <StackPanel>
                <TextBlock Text="Kiểm tra lịch trống phương tiện" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
                <TextBlock Text="Đối chiếu tức thì đơn đang thuê, đơn đã xác nhận, giữ chỗ chờ cọc và lịch bảo trì xe."
                           Style="{StaticResource Subtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- 2. QUERY & FILTER BAR -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="98" />
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="98" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Ngày nhận xe" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                    Style="{StaticResource CompactDatePicker}"
                                    AutomationProperties.Name="Ngày nhận xe" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Giờ nhận" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding TimeOptions}"
                                  SelectedItem="{Binding SelectedStartTime, Mode=TwoWay}"
                                  Height="38"
                                  AutomationProperties.Name="Giờ nhận xe" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Ngày trả xe" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                    Style="{StaticResource CompactDatePicker}"
                                    AutomationProperties.Name="Ngày trả xe" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,14,0">
                        <TextBlock Text="Giờ trả" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding TimeOptions}"
                                  SelectedItem="{Binding SelectedEndTime, Mode=TwoWay}"
                                  Height="38"
                                  AutomationProperties.Name="Giờ trả xe" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Phương tiện cụ thể" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding VehicleOptions}"
                                  SelectedItem="{Binding SelectedVehicleOption, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Height="38"
                                  AutomationProperties.Name="Chọn phương tiện" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="246" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Loại xe" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding CategoryOptions}"
                                  SelectedItem="{Binding SelectedCategoryOption, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Height="38"
                                  AutomationProperties.Name="Lọc loại xe" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Lọc trạng thái kết quả" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding AvailabilityFilterOptions}"
                                  SelectedItem="{Binding SelectedAvailabilityFilter, Mode=TwoWay}"
                                  Height="38"
                                  AutomationProperties.Name="Lọc trạng thái khả dụng" />
                    </StackPanel>

                    <!-- Validation Error Banner (if any) -->
                    <Border Grid.Column="2"
                            Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,8"
                            Margin="0,18,14,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ErrorMessage}" />
                    </Border>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Content="Đặt lại"
                                Command="{Binding ResetFilterCommand}"
                                Background="White"
                                Foreground="#1E293B"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Height="38"
                                Padding="16,0"
                                Margin="0,0,10,0" />

                        <Button Content="Kiểm tra lịch trống"
                                Command="{Binding CheckAvailabilityCommand}"
                                Height="38"
                                Padding="20,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. KPI CARDS -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TỔNG XE ĐỐI CHIẾU" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalCheckedCount}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,1" />
                    <TextBlock Text="Phương tiện trong phạm vi lọc" Style="{StaticResource Subtitle}" FontSize="11.5" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,13" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="KHẢ DỤNG (CÒN TRỐNG)" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AvailableCount}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource CustomerInk}" Margin="0,4,0,1" />
                    <TextBlock Text="Sẵn sàng nhận lịch đặt mới" Style="{StaticResource Subtitle}" FontSize="11.5" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,13" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="KHÔNG KHẢ DỤNG" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UnavailableCount}" FontSize="25" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,4,0,1" />
                    <TextBlock Text="Vướng đơn thuê / bảo trì / ngưng" Style="{StaticResource Subtitle}" FontSize="11.5" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{StaticResource CustomerSoft}" CornerRadius="12" Padding="18,13">
                <StackPanel>
                    <TextBlock Text="KHOẢNG GIỜ ĐANG XEM" Foreground="{StaticResource CustomerInk}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CheckedPeriodLabel}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CustomerInk}"
                               Margin="0,7,0,4"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FilteredCount, StringFormat=Đang hiển thị {0} xe theo bộ lọc}"
                               Style="{StaticResource Subtitle}"
                               FontSize="11.5" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. MASTER-DETAIL RESULTS -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.75*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: RESULTS DATAGRID -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0" ClipToBounds="True">
                <Grid Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="18,13">
                        <TextBlock Text="Kết quả kiểm tra đội xe" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Chọn 1 dòng xe để xem chi tiết xung đột bên phải"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   HorizontalAlignment="Right" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ResultsView}"
                              SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                              RowHeight="56"
                              AutomationProperties.Name="Kết quả kiểm tra lịch trống">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BIỂN SỐ" Binding="{Binding LicensePlate}" Width="120" />

                            <DataGridTemplateColumn Header="PHƯƠNG TIỆN" SortMemberPath="Brand" Width="155">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0">
                                                <Run Text="{Binding CategoryName, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SeatCount, Mode=OneWay}" />
                                                <Run Text=" chỗ" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="GIÁ/NGÀY" Binding="{Binding DailyRate, StringFormat={}{0:N0}}" Width="104" />

                            <DataGridTemplateColumn Header="KẾT LUẬN" SortMemberPath="IsAvailable" Width="148">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="9,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource CustomerSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding AvailabilityLabel}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource CustomerInk}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="NGUYÊN NHÂN / GHI CHÚ" Width="*" MinWidth="185">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SummaryReason}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SummaryReason}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                Margin="0,40,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Không có phương tiện khớp bộ lọc"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Hãy đổi bộ lọc kết quả hoặc nhấn Đặt lại để kiểm tra toàn bộ đội xe."
                                   Style="{StaticResource Subtitle}"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <ProgressBar Grid.Row="2"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"
                                 BorderThickness="0"
                                 Foreground="{StaticResource CustomerInk}" />
                </Grid>
            </Border>

            <!-- RIGHT: SELECTED VEHICLE CONFLICT DETAILS -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18">
                <Grid>
                    <ContentControl Content="{Binding SelectedResult}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedResult}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="ContentTemplate" Value="{StaticResource SelectedResultTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="14,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedResult}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Chưa chọn phương tiện"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Chọn một dòng phương tiện ở bảng bên trái để xem chi tiết tình trạng trống lịch và từng nguyên nhân xung đột."
                                   Style="{StaticResource Subtitle}"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. STATUS FOOTER -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource Subtitle}"
                   FontSize="11"
                   Margin="2,9,0,0" />
    </Grid>
</Page>
