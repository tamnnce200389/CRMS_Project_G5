<Page x:Class="CRMS.Views.Admin.VehiclePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:CRMS.ViewModels"
      Title="Quản lý xe">
    <Page.DataContext>
        <vm:VehicleViewModel />
    </Page.DataContext>

    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER & ACTIONS -->
        <DockPanel Margin="0,0,0,22" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Kiểm tra lịch trống"
                        Click="OpenAvailability_Click"
                        Background="White"
                        Foreground="#1D4ED8"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        Padding="14,10"
                        Margin="0,0,8,0" />

                <Button Content="Lịch bảo trì"
                        Click="OpenMaintenance_Click"
                        Background="White"
                        Foreground="#B45309"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        Padding="14,10"
                        Margin="0,0,8,0" />

                <Button Content="Danh mục loại xe"
                        Command="{Binding ManageCategoriesCommand}"
                        Background="White"
                        Foreground="#1E293B"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Padding="15,10"
                        Margin="0,0,10,0" />

                <Button Content="+ Thêm xe mới"
                        Command="{Binding AddVehicleCommand}"
                        Padding="16,10"
                        Margin="0,0,10,0" />

                <Button Content="↻  Làm mới"
                        Command="{Binding RefreshCommand}"
                        Background="White"
                        Foreground="#1E293B"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Padding="14,10" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Quản lý đội xe" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Thêm mới, cập nhật thông số, quản lý bộ ảnh, loại xe và trạng thái khai thác."
                           Style="{StaticResource Subtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- KPI CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ XE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalVehicles}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Text="Phương tiện trong hệ thống" Style="{StaticResource Subtitle}" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="ĐANG HOẠT ĐỘNG" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ActiveCount}" FontSize="28" FontWeight="SemiBold" Foreground="#098568" Margin="0,6,0,2" />
                    <TextBlock Text="Sẵn sàng nhận lịch đặt" Style="{StaticResource Subtitle}" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="TẠM NGƯNG" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SuspendedCount}" FontSize="28" FontWeight="SemiBold" Foreground="#B45309" Margin="0,6,0,2" />
                    <TextBlock Text="Ngừng cho thuê mới" Style="{StaticResource Subtitle}" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#EAF1FF" CornerRadius="12" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="ĐANG HIỂN THỊ" Foreground="#2563EB" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FilteredCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,6,0,2" />
                    <TextBlock Text="Khớp với điều kiện lọc" Style="{StaticResource Subtitle}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- FILTERS -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Tìm kiếm xe" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Grid>
                    <TextBox Height="40"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Tìm kiếm xe" />
                    <TextBlock Text="Nhập biển số, hãng, mẫu hoặc loại xe…"
                               Margin="14,0"
                               Foreground="#8B97AA"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                <TextBlock Text="Loại xe" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                <ComboBox ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategoryFilter}"
                          Height="40"
                          AutomationProperties.Name="Loại xe" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Trạng thái" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          Height="40"
                          AutomationProperties.Name="Trạng thái xe">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource VietnameseLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- VEHICLE TABLE -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid Margin="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="18,14">
                    <TextBlock Text="Danh sách phương tiện" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Nhấn Sửa hoặc đúp chuột vào dòng để cập nhật xe &amp; bộ ảnh"
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding VehiclesView}"
                          SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                          MouseDoubleClick="VehiclesGrid_MouseDoubleClick"
                          RowHeight="60"
                          AutomationProperties.Name="Danh sách xe">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ẢNH" Width="78" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="50" Height="34" CornerRadius="6" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding ImageCount, StringFormat={}{0} ảnh}"
                                                       FontSize="10"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding PrimaryImageUrl}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="BIỂN SỐ" Binding="{Binding LicensePlate}" Width="136" />

                        <DataGridTemplateColumn Header="PHƯƠNG TIỆN" SortMemberPath="Brand" Width="*" MinWidth="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Brand}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Model}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="LOẠI XE" Binding="{Binding CategoryName}" Width="92" />

                        <DataGridTemplateColumn Header="NĂM / GHẾ" SortMemberPath="ManufactureYear" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ManufactureYear}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SeatCount, StringFormat={}{0} chỗ}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="HỘP SỐ / NL" SortMemberPath="Transmission" Width="136">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Transmission, Converter={StaticResource VietnameseLabel}}" FontSize="12" />
                                        <TextBlock Text="{Binding FuelType, Converter={StaticResource VietnameseLabel}}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ODO (KM)" Binding="{Binding OdometerKm, StringFormat={}{0:N0}}" Width="92" />

                        <DataGridTextColumn Header="GIÁ/NGÀY · VNĐ" Binding="{Binding DailyRate, StringFormat={}{0:N0}}" Width="124" />

                        <DataGridTemplateColumn Header="TRẠNG THÁI" SortMemberPath="OperationalStatus" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5" Padding="9,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#E7F6F0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding OperationalStatus, Converter={StaticResource VietnameseLabel}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#B45309" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#098568" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="THAO TÁC" Width="178">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Sửa"
                                                Command="{Binding DataContext.EditVehicleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="11,6"
                                                FontSize="12"
                                                Margin="0,0,6,0" />

                                        <Button Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,6"
                                                FontSize="12"
                                                BorderThickness="1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Kích hoạt" />
                                                    <Setter Property="Background" Value="#E7F6F0" />
                                                    <Setter Property="Foreground" Value="#098568" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Content" Value="Tạm ngưng" />
                                                            <Setter Property="Background" Value="#FFF7ED" />
                                                            <Setter Property="Foreground" Value="#C2410C" />
                                                            <Setter Property="BorderBrush" Value="#FED7AA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- EMPTY STATE -->
                <StackPanel Grid.Row="1" Margin="0,44,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Chưa có xe phù hợp" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Điều chỉnh bộ lọc hoặc nhấn + Thêm xe mới để đăng ký phương tiện." Style="{StaticResource Subtitle}" Margin="0,8,0,0" />
                </StackPanel>

                <ProgressBar Grid.Row="2"
                             Height="3"
                             IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"
                             BorderThickness="0"
                             Foreground="{StaticResource Accent}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource Subtitle}"
                   FontSize="11"
                   Margin="2,10,0,0" />
    </Grid>
</Page>
