<Page x:Class="CRMS.Views.Admin.DriverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:CRMS.ViewModels"
      Title="Tài xế">

    <Page.DataContext>
        <vm:DriverViewModel />
    </Page.DataContext>

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <DockPanel Margin="0,0,0,24" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="+ Tài xế mới"
                        Command="{Binding NewCommand}"
                        Padding="14,9"
                        Margin="0,0,8,0"/>

                <Button Content="↻ Làm mới"
                        Command="{Binding RefreshCommand}"
                        Padding="14,9"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Quản lý tài xế"
                           Style="{StaticResource PageTitle}"/>

                <TextBlock Text="Thêm, cập nhật thông tin và quản lý trạng thái hoạt động."
                           Style="{StaticResource Subtitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Thống kê -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}"
                    Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ TÀI XẾ"
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding TotalDrivers}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,7,0,2"/>

                    <TextBlock Text="Đã đăng ký trong hệ thống"
                               Style="{StaticResource Subtitle}"
                               FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ĐANG HOẠT ĐỘNG"
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ActiveDrivers}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#098568"
                               Margin="0,7,0,2"/>

                    <TextBlock Text="Tài xế có trạng thái hoạt động"
                               Style="{StaticResource Subtitle}"
                               FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Danh sách và form chỉnh sửa -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Bảng tài xế -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    Margin="0,0,16,0">

                <Grid Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="18,18">
                        <TextBlock Text="Tất cả tài xế"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Chọn một dòng để chỉnh sửa"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Drivers}"
                              SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                              AutomationProperties.Name="Danh sách tài xế"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ"
                                                Binding="{Binding DriverId}"
                                                Width="55"/>

                            <DataGridTextColumn Header="HỌ VÀ TÊN"
                                                Binding="{Binding FullName}"
                                                Width="*"
                                                MinWidth="120"/>

                            <DataGridTextColumn Header="SỐ ĐIỆN THOẠI"
                                                Binding="{Binding Phone}"
                                                Width="110"/>

                            <DataGridTemplateColumn Header="TRẠNG THÁI"
                                                    SortMemberPath="IsActive"
                                                    Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5"
                                                Padding="8,4"
                                                HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="#F1F3F7"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="#E7F6F0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock FontSize="10"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                                Value="Ngừng hoạt động"/>

                                                        <Setter Property="Foreground"
                                                                Value="#728096"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}"
                                                                         Value="True">
                                                                <Setter Property="Text"
                                                                        Value="Hoạt động"/>

                                                                <Setter Property="Foreground"
                                                                        Value="#098568"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thông báo khi danh sách trống -->
                    <StackPanel Grid.Row="1"
                                Margin="0,44,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                IsHitTestVisible="False">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalDrivers}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsLoading}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Chưa có tài xế để hiển thị"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Nhấn Làm mới để tải danh sách."
                                   Style="{StaticResource Subtitle}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <ProgressBar Grid.Row="2"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"
                                 Foreground="{StaticResource Accent}"
                                 BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- Form tài xế -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>
                        <TextBlock Text="Thông tin tài xế"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Chọn tài xế trong bảng để chỉnh sửa, hoặc nhấn Tài xế mới."
                                   Style="{StaticResource Subtitle}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,22"/>

                        <TextBlock Text="Họ và tên *"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>

                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,7,0,16"
                                 Padding="10,8"/>

                        <TextBlock Text="Số điện thoại"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>

                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,7,0,16"
                                 Padding="10,8"/>

                        <TextBlock Text="Số giấy phép lái xe"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>

                        <TextBox Text="{Binding LicenseNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,7,0,16"
                                 Padding="10,8"/>

                        <TextBlock Text="Ghi chú"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>

                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,7,0,16"
                                 Padding="10,8"
                                 MinHeight="65"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>

                        <CheckBox Content="Tài xế đang hoạt động"
                                  IsChecked="{Binding IsActive, Mode=TwoWay}"
                                  Margin="0,0,0,22"/>

                        <Button Content="Lưu tài xế"
                                Command="{Binding SaveCommand}"
                                Padding="12,10"
                                Margin="0,0,0,10"/>

                        <Button Content="Ngừng / kích hoạt tài xế"
                                Command="{Binding ToggleActiveCommand}"
                                Padding="12,10"
                                Margin="0,0,0,10"/>

                        <Button Content="Nhập mới / Xóa form"
                                Command="{Binding NewCommand}"
                                Padding="12,10"/>

                        <TextBlock Text="* Họ và tên là thông tin bắt buộc."
                                   Style="{StaticResource Subtitle}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Trạng thái xử lý -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource Subtitle}"
                   FontSize="11"
                   Margin="2,12,0,0"/>
    </Grid>
</Page>
