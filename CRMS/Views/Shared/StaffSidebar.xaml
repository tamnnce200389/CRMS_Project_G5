<UserControl x:Class="CRMS.Views.Shared.StaffSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="250"
             Background="#103B34"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- MENU BUTTON -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D7F4EA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#176453"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#80AA9D"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- COLLAPSIBLE GROUP -->
        <Style x:Key="MenuGroup" TargetType="Expander">
            <Setter Property="Margin" Value="10,4,10,0"/>
            <Setter Property="Foreground" Value="#A4E1D0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton
                                Content="{TemplateBinding Header}"
                                IsChecked="{Binding IsExpanded,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}"
                                Foreground="#A4E1D0"
                                Cursor="Hand">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBackground"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                Padding="13,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="⌄"
                                                           FontSize="16"
                                                           Foreground="#A4E1D0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="HeaderBackground"
                                                        Property="Background"
                                                        Value="#17594C"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked"
                                                     Value="True">
                                                <Setter TargetName="HeaderBackground"
                                                        Property="Background"
                                                        Value="#207261"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ExpandContent"
                                              ContentSource="Content"
                                              Visibility="Collapsed"
                                              Margin="0,3,0,5"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandContent"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="#103B34">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="24,25,20,15">
                <TextBlock Text="CRMS"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="STAFF WORKSPACE"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#9AE5CF"
                           Margin="0,5,0,0"/>

                <Border Background="#1D594D"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,18,0,0">
                    <TextBlock Text="KHU VỰC NHÂN VIÊN"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- MENU -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="0,0,0,12">

                    <!-- TỔNG QUAN -->
                    <Expander x:Name="OverviewGroup"
                              Header="TỔNG QUAN"
                              Style="{StaticResource MenuGroup}"
                              Expanded="Group_Expanded">
                        <StackPanel>
                            <Button Content="Tổng quan công việc"
                                    Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Dashboard"/>
                        </StackPanel>
                    </Expander>

                    <!-- ĐƠN THUÊ -->
                    <Expander x:Name="BookingGroup"
                              Header="QUẢN LÝ ĐƠN THUÊ"
                              Style="{StaticResource MenuGroup}"
                              Expanded="Group_Expanded">
                        <StackPanel>
                            <Button Content="Danh sách đơn thuê"
                                    Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Bookings"/>

                            <Button Content="Tổng hợp thanh toán"
                                    Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="PaymentSummary"/>
                        </StackPanel>
                    </Expander>

                    <!-- TRA CỨU -->
                    <Expander x:Name="LookupGroup"
                              Header="TRA CỨU"
                              Style="{StaticResource MenuGroup}"
                              Expanded="Group_Expanded">
                        <StackPanel>
                            <Button Content="Tra cứu xe"
                                    Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Vehicles"/>

                            <Button Content="Tra cứu tài xế"
                                    Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Drivers"/>
                        </StackPanel>
                    </Expander>

                    <!-- VẬN HÀNH -->
                    <Expander x:Name="OperationGroup"
                              Header="VẬN HÀNH XE"
                              Style="{StaticResource MenuGroup}"
                              Expanded="Group_Expanded">
                        <StackPanel>
                            <Button Content="Phân công tài xế"
                                    Style="{StaticResource NavButton}"
                                    IsEnabled="False"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Chưa tích hợp DriverAssignmentPage"/>

                            <Button Content="Bàn giao xe"
                                    Style="{StaticResource NavButton}"
                                    IsEnabled="False"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Chưa tích hợp HandoverPage"/>

                            <Button Content="Nhận xe trả"
                                    Style="{StaticResource NavButton}"
                                    IsEnabled="False"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Chưa tích hợp ReturnPage"/>
                        </StackPanel>
                    </Expander>

                    <!-- THANH TOÁN -->
                    <Expander x:Name="PaymentGroup"
                              Header="THANH TOÁN"
                              Style="{StaticResource MenuGroup}"
                              Expanded="Group_Expanded">
                        <StackPanel>

                            <!-- Mở trang xác nhận cọc tiền mặt -->
                            <Button Content="Xác nhận cọc tiền mặt"
                                    Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="CashDeposit"/>

                            <Button Content="Thu tiền còn lại"
                                    Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="OutstandingBalance"/>

                            <Button Content="Hoàn cọc thủ công"
                                    Style="{StaticResource NavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="ManualRefund"/>
                        </StackPanel>
                    </Expander>

                    <!-- TÀI KHOẢN -->
                    <Expander x:Name="AccountGroup"
                              Header="TÀI KHOẢN"
                              Style="{StaticResource MenuGroup}"
                              Expanded="Group_Expanded">
                        <StackPanel>
                            <Button Content="Hồ sơ cá nhân"
                                    Style="{StaticResource NavButton}"
                                    IsEnabled="False"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Chưa tích hợp ProfilePage"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    BorderBrush="#326052"
                    BorderThickness="0,1,0,0"
                    Padding="22,15">
                <StackPanel>
                    <TextBlock Text="STAFF"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"/>

                    <TextBlock Text="Vận hành thuê xe"
                               Foreground="#9CD6C5"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
