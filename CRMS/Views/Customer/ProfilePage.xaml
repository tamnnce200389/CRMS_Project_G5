<Page x:Class="CRMS.Views.Customer.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Hồ sơ cá nhân" Background="{StaticResource CustomerBackground}" Foreground="{StaticResource CustomerInk}" Language="vi-VN" FontSize="14" Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28" MaxWidth="1180">
            <TextBlock Text="TÀI KHOẢN" Foreground="{StaticResource CustomerInk}" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Hồ sơ cá nhân" FontSize="28" FontWeight="Bold" Margin="0,8,0,8"/>
            <TextBlock Text="Cập nhật thông tin để CRMS có thể hỗ trợ bạn trong mỗi chuyến đi." Foreground="{StaticResource CustomerMuted}" Margin="0,0,0,26"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource CustomerInk}" CornerRadius="16" Padding="24" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Thông tin tài khoản" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,24"/>
                        <TextBlock Text="Mã khách hàng" Foreground="{StaticResource SidebarText}" FontSize="12"/>
                        <TextBox x:Name="txtUserId" IsReadOnly="True" Background="{StaticResource CustomerBackground}" Margin="0,7,0,18" Padding="12"/>
                        <TextBlock Text="Vai trò" Foreground="{StaticResource SidebarText}" FontSize="12"/>
                        <TextBox x:Name="txtRole" IsReadOnly="True" Background="{StaticResource CustomerBackground}" Margin="0,7,0,18" Padding="12"/>
                        <TextBlock Text="Trạng thái" Foreground="{StaticResource SidebarText}" FontSize="12"/>
                        <TextBox x:Name="txtStatus" IsReadOnly="True" Background="{StaticResource CustomerBackground}" Margin="0,7,0,22" Padding="12"/>
                        <TextBlock Text="Thông tin liên hệ chính xác giúp việc xác nhận và bàn giao xe thuận tiện hơn." Foreground="{StaticResource SidebarHeading}" TextWrapping="Wrap" LineHeight="22" FontSize="13"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1" CornerRadius="16" Padding="28">
                    <StackPanel>
                        <TextBlock Text="Thông tin liên hệ" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24"/>
                        <TextBlock Text="Họ và tên" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtFullName" MaxLength="120" Margin="0,8,0,20" Padding="12" MinHeight="46"/>
                        <TextBlock Text="Số điện thoại" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtPhone" MaxLength="20" Margin="0,8,0,20" Padding="12" MinHeight="46"/>
                        <TextBlock Text="Email" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtEmail" IsReadOnly="True" Background="{StaticResource CustomerBackground}" Margin="0,8,0,7" Padding="12" MinHeight="46"/>
                        <TextBlock Text="Email được dùng để đăng nhập và không thể thay đổi tại đây." Foreground="{StaticResource CustomerMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <Border Height="1" Background="{StaticResource CustomerLine}" Margin="0,26"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Quay lại" Style="{StaticResource SecondaryButton}" Click="Back_Click" Margin="0,0,10,0"/>
                            <Button Content="Lưu thay đổi" Style="{StaticResource CustomerButton}" Click="SaveChanges_Click" Padding="24,11"/>
                        </StackPanel>
                        <TextBlock x:Name="txtMessage" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
