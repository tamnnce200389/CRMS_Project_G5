<Page x:Class="CRMS.Views.Customer.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="My Profile"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{StaticResource PageBackground}" Margin="20">
            <Border Background="{StaticResource Surface}"
                    Padding="28"
                    CornerRadius="12"
                    MaxWidth="650"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">

                <StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="← Back"
                            Width="110"
                            Height="44"
                            HorizontalAlignment="Left"
                            Margin="10"
                            Click="Back_Click"/>
                    <TextBlock Text="MY PROFILE"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource Ink}"/>

                    <TextBlock Text="View and update your personal information."
                               Margin="0,8,0,24"
                               Foreground="{StaticResource MutedReadable}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="User ID"/>
                    <TextBox x:Name="txtUserId"
                             IsReadOnly="True"
                             Margin="0,5,0,15"
                             Padding="10"
                             Background="{StaticResource SurfaceMuted}"/>

                    <TextBlock Text="Full Name"/>
                    <TextBox x:Name="txtFullName"
                             MaxLength="120"
                             Margin="0,5,0,15"
                             Padding="10"/>

                    <TextBlock Text="Email"/>
                    <TextBox x:Name="txtEmail"
                             IsReadOnly="True"
                             Margin="0,5,0,15"
                             Padding="10"
                             Background="{StaticResource SurfaceMuted}"/>

                    <TextBlock Text="Phone Number"/>
                    <TextBox x:Name="txtPhone"
                             MaxLength="20"
                             Margin="0,5,0,15"
                             Padding="10"/>

                    <TextBlock Text="Role"/>
                    <TextBox x:Name="txtRole"
                             IsReadOnly="True"
                             Margin="0,5,0,15"
                             Padding="10"
                             Background="{StaticResource SurfaceMuted}"/>

                    <TextBlock Text="Account Status"/>
                    <TextBox x:Name="txtStatus"
                             IsReadOnly="True"
                             Margin="0,5,0,24"
                             Padding="10"
                             Background="{StaticResource SurfaceMuted}"/>

                    <Button Style="{StaticResource PrimaryButton}" Content="Save Changes"
                            Height="44"
                            Background="{StaticResource Ink}"
                            Foreground="{StaticResource Surface}"
                            FontWeight="Bold"
                            Click="SaveChanges_Click"/>

                    <TextBlock x:Name="txtMessage"
                               Margin="0,15,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel> 
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
