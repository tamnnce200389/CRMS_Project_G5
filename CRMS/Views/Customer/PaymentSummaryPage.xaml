<Page x:Class="CRMS.Views.Customer.PaymentSummaryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Thanh toán của tôi" Background="{StaticResource CustomerBackground}" Foreground="{StaticResource CustomerInk}" Language="vi-VN" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28" MaxWidth="1050">
            <Button Content="←  Quay lại chuyến thuê" Click="Back_Click" HorizontalAlignment="Left" Style="{StaticResource StaffSecondaryButton}" Padding="14,8" Margin="0,0,0,18"/>
            <TextBlock Text="CHI PHÍ CHUYẾN ĐI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CustomerInk}"/>
            <TextBlock Text="Thanh toán của tôi" FontSize="28" FontWeight="Bold" Margin="0,8,0,8"/>
            <TextBlock Text="Xem tiền thuê, khoản đã thanh toán và số dư của chuyến đi." Foreground="{StaticResource CustomerMuted}" Margin="0,0,0,26"/>
            <Border Background="White" CornerRadius="16" Padding="26" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tra cứu theo mã đơn thuê" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Mã đơn nằm trong mục Chuyến thuê của tôi hoặc trên phiếu thuê xe." Foreground="{StaticResource CustomerMuted}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Tra cứu thanh toán" Style="{StaticResource CustomerButton}" Command="{Binding CalculateBalanceCommand}" Margin="12,0,0,0"/>
                        <TextBox Text="{Binding BookingLookup, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Padding="12" MinHeight="46" ToolTip="Nhập mã đơn thuê của bạn"/>
                    </DockPanel>
                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </Border>
            <Border Visibility="{Binding SummaryVisibility}" Background="{StaticResource Surface}" CornerRadius="16" Padding="22" Margin="0,18,0,0" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20"><TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" Foreground="{StaticResource CustomerInk}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary.BookingCode}" FontSize="20" FontWeight="SemiBold"/></DockPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="44"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Summary.RentalAmountLabel}"/><TextBlock Grid.Column="1" Text="{Binding Summary.RentalTotal, StringFormat={}{0:N0} đ}"/>
                        <TextBlock Grid.Row="1" Text="Giảm giá đã áp dụng (không trừ thêm)" Foreground="{StaticResource CustomerMuted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.Discount, StringFormat={}{0:N0} đ}"/>
                        <TextBlock Grid.Row="2" Text="Phụ phí theo biên bản trả xe"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.ExtraFees, StringFormat={}{0:N0} đ}"/>
                        <TextBlock Grid.Row="3" Text="Cọc / chuyển khoản thực nhận"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.DepositsPaid, StringFormat={}{0:N0} đ}"/>
                        <TextBlock Grid.Row="4" Text="Tiền đã thu thêm"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.BalancesPaid, StringFormat={}{0:N0} đ}"/>
                        <TextBlock Grid.Row="5" Text="Tiền đã hoàn"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Summary.RefundsPaid, StringFormat={}{0:N0} đ}"/>
                        <TextBlock Grid.Row="6" Text="Thực nhận còn lại" FontWeight="SemiBold"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Summary.NetPaid, StringFormat={}{0:N0} đ}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="7" Text="{Binding Summary.OutstandingLabel}" FontWeight="SemiBold" Foreground="{StaticResource CustomerInk}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Summary.DisplayOutstandingBalance, StringFormat={}{0:N0} đ}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource CustomerInk}"/>
                        <TextBlock Grid.Row="8" Text="Có thể hoàn cho đơn hủy / hết hạn"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Summary.RefundableAmount, StringFormat={}{0:N0} đ}"/>
                    </Grid>
                    <TextBlock Text="{Binding Summary.DemoNote}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="Chỉ cộng các giao dịch thành công. Đơn hủy/hết hạn không được thu tiếp số dư." Foreground="{StaticResource CustomerMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CustomerBackground}" CornerRadius="10" Padding="18" Margin="0,18,0,0">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource CustomerMuted}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
