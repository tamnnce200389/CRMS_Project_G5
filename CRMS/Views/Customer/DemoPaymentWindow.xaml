<Window x:Class="CRMS.Views.Customer.DemoPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán QR demo" Width="940" Height="760" MinWidth="820" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CustomerBackground}"
        Foreground="{StaticResource CustomerInk}" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">
            <Button Content="←  Quay lại chuyến thuê" Click="Back_Click" HorizontalAlignment="Left" Style="{StaticResource StaffSecondaryButton}" Padding="14,8" Margin="0,0,0,16"/>
            <DockPanel Margin="0,0,0,20">
                <Border DockPanel.Dock="Right" Background="#FFF0D3" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock Text="CHẾ ĐỘ DEMO" Foreground="#805B13" FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <StackPanel><TextBlock Text="Thanh toán QR demo" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BookingCode}" Margin="0,5,0,0" Foreground="{StaticResource CustomerMuted}"/></StackPanel>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1" CornerRadius="18" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{Binding TransferAmountLabel}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="Quét bằng ứng dụng hỗ trợ VietQR / VNPAY" Foreground="{StaticResource CustomerMuted}" FontSize="12" TextAlignment="Center" Margin="0,8,0,12"/>
                        <Border Visibility="{Binding CanShowQr, Converter={StaticResource VisibleWhenTrue}}" Background="White" Padding="10" HorizontalAlignment="Center">
                            <Image Source="{Binding QrImage}" Width="270" Height="270" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <StackPanel Visibility="{Binding IsSuccessful, Converter={StaticResource VisibleWhenTrue}}" Margin="0,38,0,38">
                            <Border Background="{StaticResource CustomerSoft}" CornerRadius="36" Width="72" Height="72" HorizontalAlignment="Center">
                                <Path Data="M4,12 L10,18 L22,5" Stroke="{StaticResource CustomerInk}" StrokeThickness="2.5" Width="30" Height="30" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Đã thực nhận" TextAlignment="Center" Margin="0,16,0,4" Foreground="{StaticResource CustomerMuted}"/>
                            <TextBlock Text="{Binding ActualReceivedLabel}" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ReceiverLabel}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding AccountNumber}" TextAlignment="Center" Foreground="{StaticResource CustomerMuted}"/>
                        <Border Background="{StaticResource CustomerBackground}" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                            <StackPanel><TextBlock Text="Nội dung chuyển khoản" FontSize="12" Foreground="{StaticResource CustomerMuted}"/>
                                <TextBlock Text="{Binding TransferContent}" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <Button Content="Sao chép nội dung" Tag="{Binding TransferContent}" Click="CopyText_Click" Style="{StaticResource StaffSecondaryButton}" Padding="10,6"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Background="White" CornerRadius="18" Padding="22" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Thông tin đơn demo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <TextBlock Text="Tổng tiền thuê mô phỏng" Foreground="{StaticResource CustomerMuted}"/>
                            <TextBlock Text="{Binding TotalLabel}" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,18"/>
                            <TextBlock Text="Cọc mô phỏng · 50%" Foreground="{StaticResource CustomerMuted}"/>
                            <TextBlock Text="{Binding SimulatedDepositLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,18"/>
                            <Border Background="#FFF6E5" CornerRadius="10" Padding="12">
                                <TextBlock Text="Chỉ chuyển thử nghiệm 1.000đ. Không chuyển số tiền thuê hoặc tiền cọc mô phỏng ở trên." Foreground="#805B13" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="16" Padding="18" Margin="0,16,0,0">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource CustomerSoft}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsSuccessful}" Value="True"><Setter Property="Background" Value="#DEF3E4"/></DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding BookingStatusLabel}" Margin="0,7,0,0" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding DeadlineLabel}" Foreground="{StaticResource CustomerMuted}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="CheckStatusButton" Content="{Binding CheckStatusButtonText}" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanCheckStatus}" Style="{StaticResource CustomerButton}" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding LastCheckedLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CustomerInk}" TextWrapping="Wrap" Margin="0,10,0,0" TextAlignment="Center"/>
                    <TextBlock Text="Trạng thái tự cập nhật khi Staff xác nhận." FontSize="12" Foreground="{StaticResource CustomerMuted}" TextWrapping="Wrap" Margin="0,10,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
