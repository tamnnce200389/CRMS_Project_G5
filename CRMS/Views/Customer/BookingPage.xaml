<Page x:Class="CRMS.Views.Customer.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Đặt xe" Background="#F4F8F6">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Đặt xe" FontSize="30" FontWeight="Bold" Foreground="#173B32"/>
                <TextBlock Text="Giá thuê, voucher và tiền cọc sẽ được kiểm tra lại phía SQL khi xác nhận đặt xe."
                           Margin="0,8,0,22" Foreground="#64748B" TextWrapping="Wrap"/>

                <TextBlock Text="Chọn xe" FontWeight="SemiBold"/>
                <ComboBox x:Name="VehicleBox" DisplayMemberPath="DisplayName" SelectedValuePath="VehicleId"
                          Height="38" Margin="0,6,0,16" SelectionChanged="BookingInputs_Changed"/>

                <TextBlock Text="Hình thức thuê" FontWeight="SemiBold"/>
                <ComboBox x:Name="RentalTypeBox" SelectedIndex="0" Height="38" Margin="0,6,0,16"
                          SelectionChanged="BookingInputs_Changed">
                    <ComboBoxItem Content="Tự lái (SelfDrive)" Tag="SelfDrive"/>
                    <ComboBoxItem Content="Có tài xế (WithDriver)" Tag="WithDriver"/>
                </ComboBox>

                <TextBlock Text="Phương thức cọc" FontWeight="SemiBold"/>
                <ComboBox x:Name="DepositMethodBox" SelectedIndex="0" Height="38" Margin="0,6,0,16">
                    <ComboBoxItem Content="VNPay" Tag="VNPay"/>
                    <ComboBoxItem Content="Tiền mặt (Cash)" Tag="Cash"/>
                </ComboBox>

                <TextBlock Text="Ngày giờ nhận xe (giờ địa phương)" FontWeight="SemiBold"/>
                <DatePicker x:Name="StartDate" Margin="0,6,0,8" Height="34"
                            SelectedDateChanged="BookingInputs_Changed"/>
                <TextBox x:Name="StartTime" Text="09:00" Height="36" Padding="8" Margin="0,0,0,16"
                         TextChanged="BookingInputs_TextChanged"/>

                <TextBlock Text="Ngày giờ trả xe (giờ địa phương)" FontWeight="SemiBold"/>
                <DatePicker x:Name="EndDate" Margin="0,6,0,8" Height="34"
                            SelectedDateChanged="BookingInputs_Changed"/>
                <TextBox x:Name="EndTime" Text="09:00" Height="36" Padding="8" Margin="0,0,0,20"
                         TextChanged="BookingInputs_TextChanged"/>

                <Border x:Name="VoucherSection" Background="White" BorderBrush="#D9E5DF" BorderThickness="1"
                        CornerRadius="10" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Ưu đãi Voucher" FontSize="18" FontWeight="Bold" Foreground="#173B32"/>
                        <TextBlock Text="Tải danh sách Voucher phù hợp với xe và thời gian thuê, hoặc nhập mã của bạn."
                                   Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,12"/>

                        <Button Content="Xem Voucher khả dụng" Height="36" Width="190"
                                HorizontalAlignment="Left" Click="LoadVouchers_Click"
                                Background="#E8F2ED" Foreground="#176B53" BorderBrush="#C6DED2"/>

                        <TextBlock Text="Chọn Voucher khả dụng" FontWeight="SemiBold" Margin="0,14,0,5"/>
                        <ComboBox x:Name="VoucherBox" Height="36" DisplayMemberPath="DisplayText"
                                  SelectedValuePath="VoucherCode" SelectionChanged="VoucherBox_SelectionChanged"
                                  IsTextSearchEnabled="True"/>

                        <TextBlock Text="Hoặc nhập mã Voucher" FontWeight="SemiBold" Margin="0,12,0,5"/>
                        <TextBox x:Name="VoucherCodeBox" Height="36" Padding="8"
                                 TextChanged="VoucherCodeBox_TextChanged"/>

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="ApplyVoucherButton" Content="Kiểm tra và áp dụng thử"
                                    Height="38" Padding="14,0" Margin="0,0,8,0"
                                    Click="ApplyVoucher_Click" Background="#176B53" Foreground="White"/>
                            <Button Content="Bỏ Voucher" Height="38" Padding="14,0"
                                    Click="ClearVoucher_Click" Background="#F1F5F9" Foreground="#334155"/>
                        </WrapPanel>

                        <TextBlock x:Name="VoucherMessageText" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="#475569"/>

                        <Border x:Name="VoucherSummaryPanel" Visibility="Collapsed"
                                Background="#F0F8F3" BorderBrush="#C6DED2" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Tóm tắt ưu đãi" FontWeight="Bold" Foreground="#176B53"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Tổng tiền trước giảm" Grid.Row="0" Foreground="#475569" Margin="0,3"/>
                                    <TextBlock x:Name="GrossAmountText" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Margin="12,3,0,3"/>
                                    <TextBlock Text="Voucher giảm" Grid.Row="1" Foreground="#475569" Margin="0,3"/>
                                    <TextBlock x:Name="DiscountAmountText" Grid.Row="1" Grid.Column="1" Foreground="#15803D" FontWeight="Bold" Margin="12,3,0,3"/>
                                    <TextBlock Text="Tổng thanh toán" Grid.Row="2" Foreground="#475569" Margin="0,3"/>
                                    <TextBlock x:Name="TotalAmountText" Grid.Row="2" Grid.Column="1" FontWeight="Bold" Margin="12,3,0,3"/>
                                    <TextBlock Text="Tiền cọc dự kiến" Grid.Row="3" Foreground="#475569" Margin="0,3"/>
                                    <TextBlock x:Name="DepositAmountText" Grid.Row="3" Grid.Column="1" FontWeight="Bold" Margin="12,3,0,3"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="VoucherUnavailableText" Visibility="Collapsed"
                           Text="Database hiện tại chưa hỗ trợ áp dụng Voucher khi tạo Booking. Bạn vẫn có thể đặt xe bình thường mà không dùng Voucher."
                           Foreground="#9A6700" TextWrapping="Wrap" Margin="0,0,0,18"/>

                <Button x:Name="PlaceButton" Content="Xác nhận đặt xe" Height="46"
                        Background="#176B53" Foreground="White" FontWeight="Bold"
                        Click="PlaceBooking_Click"/>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#475569"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
