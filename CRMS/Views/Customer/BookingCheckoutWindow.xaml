<Window x:Class="CRMS.Views.Customer.BookingCheckoutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Xác nhận thuê xe" Width="580" Height="700" FontSize="14" Foreground="{StaticResource CustomerInk}" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource CustomerBackground}">
 <Border Margin="24" Padding="24" Background="White" CornerRadius="16">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <TextBlock Text="Xác nhận thuê xe" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="{Binding VehicleName}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,6"/>
   <TextBlock Text="{Binding RentalLabel}"/>
   <TextBlock Text="{Binding PeriodLabel}" Margin="0,8,0,20"/>
   <TextBlock Text="Tổng tiền thuê" Style="{StaticResource Subtitle}"/>
   <TextBlock Text="{Binding TotalLabel}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource CustomerInk}"/>
   <TextBlock Text="{Binding DepositCaption}" Margin="0,12,0,3"/>
   <TextBlock Text="{Binding DepositLabel}" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Phương thức đặt cọc" Margin="0,16,0,6"/>
   <ComboBox SelectedValue="{Binding DepositMethod, Mode=TwoWay}" SelectedValuePath="Tag" IsEnabled="{Binding CanChooseDepositMethod}" Padding="10" MinHeight="42">
    <ComboBoxItem Content="Tiền mặt · Nhân viên xác nhận" Tag="Cash"/>
    <ComboBoxItem Content="QR demo · Chỉ chuyển thử nghiệm 1.000đ" Tag="Demo" IsEnabled="{Binding DemoPaymentsEnabled}"/>
   </ComboBox>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16,0,16" MinHeight="44"/>
   <Button Content="Xác nhận tạo đơn" Style="{StaticResource CustomerButton}" Command="{Binding ConfirmCommand}"/>
  </StackPanel>
  </ScrollViewer>
 </Border>
</Window>
