<Window x:Class="CRMS.Views.Customer.BookingCheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận thuê xe"
        Width="560"
        Height="680"
        MinHeight="620"
        FontSize="14"
        Foreground="{StaticResource CustomerInk}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CustomerBackground}">

    <Border Margin="24"
            Padding="24"
            Background="White"
            CornerRadius="16">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Xác nhận thuê xe"
                           Style="{StaticResource PageTitle}"/>

                <TextBlock Text="{Binding VehicleName}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,16,0,6"/>

                <TextBlock Text="{Binding RentalLabel}"/>

                <TextBlock Text="{Binding PeriodLabel}"
                           Margin="0,8,0,20"/>

                <TextBlock Text="Tổng tiền thuê"
                           Style="{StaticResource Subtitle}"/>

                <TextBlock Text="{Binding TotalLabel}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource CustomerInk}"/>

                <TextBlock Text="Tiền cọc 50%"
                           Margin="0,12,0,3"/>

                <TextBlock Text="{Binding DepositLabel}"
                           FontSize="18"
                           FontWeight="SemiBold"/>

                <!-- TV7 - F21: Apply Voucher -->
                <Separator Margin="0,20,0,16"/>

                <TextBlock Text="Mã giảm giá"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding VoucherCode, UpdateSourceTrigger=PropertyChanged}"
                             Height="38"
                             Padding="10,6"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0"/>

                    <Button Grid.Column="1"
                            Content="Áp dụng"
                            Width="100"
                            Height="38"
                            Command="{Binding ApplyVoucherCommand}"/>
                </Grid>

                <TextBlock Text="{Binding VoucherMessage}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>

                <TextBlock Text="{Binding DiscountLabel}"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <Separator Margin="0,18,0,16"/>

                <TextBlock Text="{Binding Status}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           MinHeight="44"/>

                <Button Content="Xác nhận tạo đơn"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
