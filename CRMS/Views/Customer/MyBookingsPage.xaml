<Page x:Class="CRMS.Views.Customer.MyBookingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Chuyến thuê của tôi" Background="{StaticResource CustomerBackground}" Foreground="{StaticResource CustomerInk}" Language="vi-VN" FontSize="14" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28" MaxWidth="1180">
            <TextBlock Text="HÀNH TRÌNH CỦA BẠN" Foreground="{StaticResource CustomerInk}" FontSize="11" FontWeight="Bold"/>
            <DockPanel Margin="0,8,0,8">
                <Button DockPanel.Dock="Right" Content="Tìm chuyến đi mới" Style="{StaticResource CustomerButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Home"/>
                <TextBlock Text="Chuyến thuê của tôi" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Theo dõi lịch thuê, trạng thái và chi phí của từng hành trình." Foreground="{StaticResource CustomerMuted}" Margin="0,0,0,26"/>
            <Border x:Name="StatePanel" Background="White" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1" CornerRadius="16" Padding="36" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="StateTitle" Text="Đang tải chuyến thuê…" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock x:Name="StateDescription" Text="Vui lòng đợi trong giây lát." Foreground="{StaticResource CustomerMuted}" Margin="0,10,0,18" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button x:Name="RetryButton" Content="Tải lại" Style="{StaticResource SecondaryButton}" Click="Page_Loaded" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="BookingsList">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="White" BorderBrush="{StaticResource CustomerLine}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource CustomerBackground}" CornerRadius="7" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource CustomerMuted}" FontWeight="SemiBold" FontSize="12"/></Border>
                                <StackPanel><TextBlock Text="{Binding BookingCode}" Foreground="{StaticResource CustomerMuted}" FontSize="12"/><TextBlock Text="{Binding VehicleName}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource CustomerLine}" Margin="0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Nhận xe" Foreground="{StaticResource CustomerMuted}" FontSize="12"/><TextBlock Text="{Binding StartAt, StringFormat={}{0:HH:mm · dd/MM/yyyy}}" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Trả xe" Foreground="{StaticResource CustomerMuted}" FontSize="12"/><TextBlock Text="{Binding EndAt, StringFormat={}{0:HH:mm · dd/MM/yyyy}}" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Tổng tiền thuê" Foreground="{StaticResource CustomerMuted}" FontSize="12"/><TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                                <Button Grid.Column="3" Content="Xem thanh toán" Style="{StaticResource SecondaryButton}" Click="Payment_Click" Tag="{Binding BookingCode}" Margin="16,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
