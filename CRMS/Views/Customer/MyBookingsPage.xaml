<Page x:Class="CRMS.Views.Customer.MyBookingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Lịch sử đặt xe" Background="#F4F8F6">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="← Trang chủ" Padding="16,9" Margin="0,0,18,0"
                    Background="#173B32" Foreground="White" FontWeight="SemiBold"
                    Click="Home_Click"/>
            <StackPanel>
                <TextBlock Text="Lịch sử đặt xe" FontSize="28" FontWeight="Bold" Foreground="#173B32"/>
                <TextBlock Text="Theo dõi trạng thái, thời gian thuê, giá, tiền cọc và tài xế của các đơn của bạn."
                           Margin="0,6,0,0" Foreground="#64748B"/>
            </StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Làm mới" Padding="18,8" Click="Refresh_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#475569"/>
        </DockPanel>
        <DataGrid x:Name="BookingsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  Background="White"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã đơn" Binding="{Binding BookingCode}" Width="Auto" MinWidth="135"/>
                <DataGridTextColumn Header="Xe" Binding="{Binding VehicleName}" Width="Auto" MinWidth="150"/>
                <DataGridTextColumn Header="Biển số" Binding="{Binding LicensePlate}" Width="Auto" MinWidth="115"/>
                <DataGridTextColumn Header="Nhận xe" Binding="{Binding StartAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="Auto" MinWidth="140"/>
                <DataGridTextColumn Header="Trả xe" Binding="{Binding EndAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="Auto" MinWidth="140"/>
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat={}{0:N0} đ}" Width="Auto" MinWidth="115"/>
                <DataGridTextColumn Header="Tiền cọc" Binding="{Binding DepositAmount, StringFormat={}{0:N0} đ}" Width="Auto" MinWidth="115"/>
                <DataGridTextColumn Header="Hạn cọc" Binding="{Binding DepositDeadline, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="Auto" MinWidth="135"/>
                <DataGridTextColumn Header="Trạng thái Booking" Binding="{Binding BookingStatus}" Width="Auto" MinWidth="135"/>
                <DataGridTextColumn Header="PT Cọc" Binding="{Binding DepositMethodDisplay}" Width="Auto" MinWidth="90"/>
                <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentStatus}" Width="Auto" MinWidth="125"/>
                <DataGridTextColumn Header="Hình thức thuê" Binding="{Binding RentalType}" Width="Auto" MinWidth="115"/>
                <DataGridTextColumn Header="Tài xế" Binding="{Binding DriverName}" Width="Auto" MinWidth="160"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Thanh toán cọc (VNPay Demo)" Padding="18,9" Margin="0,0,10,0"
                    Background="#D71920" Foreground="White" Click="PayDeposit_Click"/>
            <Button Content="Yêu cầu hủy đơn đã chọn" Padding="18,9"
                    Background="#B91C1C" Foreground="White" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Page>
