<Window x:Class="CRMS.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRMS - Register"
        Height="640"
        Width="470"
        MinHeight="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceMuted}">

    <Border Margin="20"
            Background="{StaticResource Surface}"
            CornerRadius="12"
            Padding="30">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Title -->
                <TextBlock Text="CRMS"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryHover}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Create your account"
                           FontSize="14"
                           Foreground="{StaticResource MutedReadable}"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                <!-- Full name -->
                <TextBlock Text="Full Name"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox Height="36"
                         Padding="10,6"
                         Text="{Binding FullName,
                             UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Email -->
                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Margin="0,15,0,6"/>

                <TextBox Height="36"
                         Padding="10,6"
                         Text="{Binding Email,
                             UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Phone -->
                <TextBlock Text="Phone Number"
                           FontWeight="SemiBold"
                           Margin="0,15,0,6"/>

                <TextBox Height="36"
                         Padding="10,6"
                         Text="{Binding Phone,
                             UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Margin="0,15,0,6"/>

                <PasswordBox x:Name="PasswordInput"
                             Height="36"
                             Padding="10,6"/>

                <!-- Confirm password -->
                <TextBlock Text="Confirm Password"
                           FontWeight="SemiBold"
                           Margin="0,15,0,6"/>

                <PasswordBox x:Name="ConfirmPasswordInput"
                             Height="36"
                             Padding="10,6"/>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Danger}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,10"
                           MinHeight="25"/>

                <!-- Register button -->
                <Button Content="Register"
                        Height="42"
                        Click="Register_Click"
                        IsEnabled="{Binding IsNotLoading}"
                        Background="{StaticResource PrimaryHover}"
                        Foreground="{StaticResource Surface}"
                        FontWeight="Bold"
                        Cursor="Hand"/>

                <!-- Back to Login -->
                <Button Content="Back to Login"
                        Height="35"
                        Margin="0,10,0,0"
                        Click="BackToLogin_Click"
                        Background="Transparent"
                        Foreground="{StaticResource PrimaryHover}"
                        BorderThickness="0"
                        Cursor="Hand"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
