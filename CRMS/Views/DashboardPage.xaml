<Page x:Class="CRMS.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tổng quan">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <TextBlock Text="Tổng quan hệ thống" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Quản lý hoạt động cho thuê xe tập trung và thuận tiện." Style="{StaticResource Subtitle}" Margin="0,0,0,26" />
            <Border CornerRadius="16" Padding="30" Margin="0,0,0,26">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#183A72" Offset="0" />
                        <GradientStop Color="#2563EB" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="QUẢN LÝ TẬP TRUNG, VẬN HÀNH DỄ DÀNG" Foreground="#B7D0FF" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="Sẵn sàng cho mỗi hành trình." Foreground="White" FontSize="29" FontWeight="SemiBold" Margin="0,16,0,10" TextWrapping="Wrap" />
                        <TextBlock Text="Theo dõi đội xe và thông tin tài xế.&#xA;Đơn giản hóa công việc quản lý mỗi ngày." Foreground="#D2E1FF" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
                        <Button Content="Khám phá đội xe  →" Background="White" Foreground="#1D4ED8" HorizontalAlignment="Left" Margin="0,22,0,0" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Vehicles" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="112" Height="112" CornerRadius="56" Background="#22FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="Truy cập nhanh" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <Border Background="#EAF1FF" Width="42" Height="42" CornerRadius="10" HorizontalAlignment="Left">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#2563EB" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Danh sách xe" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
                        <TextBlock Text="Xem danh sách xe, so sánh giá thuê và lọc theo trạng thái hoạt động." Style="{StaticResource Subtitle}" MinHeight="44" />
                        <Button Content="Xem danh sách xe  →" HorizontalAlignment="Left" Margin="0,18,0,0" Background="#EDF3FF" Foreground="#2563EB" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Vehicles" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="#E7F6F0" Width="42" Height="42" CornerRadius="10" HorizontalAlignment="Left">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#098568" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Danh sách tài xế" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8" />
                        <TextBlock Text="Tra cứu liên hệ, giấy phép lái xe và trạng thái hoạt động của tài xế." Style="{StaticResource Subtitle}" MinHeight="44" />
                        <Button Content="Xem tài xế  →" HorizontalAlignment="Left" Margin="0,18,0,0" Background="#EDF3FF" Foreground="#2563EB" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Drivers" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Các tính năng sắp ra mắt" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Quản lý đơn thuê và báo cáo kinh doanh sẽ được bổ sung trong các bản cập nhật tiếp theo." Style="{StaticResource Subtitle}" Margin="0,6,16,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FFF5DF" CornerRadius="5" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="ĐANG PHÁT TRIỂN" Foreground="#A16B11" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>