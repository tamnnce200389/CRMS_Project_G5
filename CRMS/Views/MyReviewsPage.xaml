<Page x:Class="CRMS.Views.MyReviewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="My Reviews"
      Background="#F3F6FB">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="ĐÁNH GIÁ CỦA TÔI"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#172B4D"/>

                <TextBlock Text="Xem và viết đánh giá về các đơn thuê xe của bạn."
                           Margin="0,7,0,0"
                           FontSize="13"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="WriteReviewButton"
                        Content="Viết đánh giá"
                        Click="WriteReview_Click"
                        Width="135"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="#16A34A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Làm mới"
                        Command="{Binding RefreshCommand}"
                        Width="110"
                        Height="38"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,15">

            <TextBlock Text="{Binding Status}"
                       FontSize="13"
                       Foreground="#475569"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Review List -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="14">

            <DataGrid ItemsSource="{Binding Reviews}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="44"
                      ColumnHeaderHeight="42"
                      BorderThickness="0"
                      Background="White"
                      AlternatingRowBackground="#F8FAFC"
                      HorizontalGridLinesBrush="#E2E8F0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Mã đánh giá"
                                        Binding="{Binding ReviewId}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Mã đơn thuê"
                                        Binding="{Binding BookingId}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Số sao"
                                        Binding="{Binding Rating}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Nội dung đánh giá"
                                        Binding="{Binding Comment}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Ngày đánh giá"
                                        Binding="{Binding CreatedAt,
                                                  StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="155"/>

                    <DataGridTemplateColumn Header="Trạng thái"
                                            Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Text"
                                                    Value="Chờ duyệt"/>

                                            <Setter Property="Foreground"
                                                    Value="#D97706"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible}"
                                                             Value="True">

                                                    <Setter Property="Text"
                                                            Value="Đã hiển thị"/>

                                                    <Setter Property="Foreground"
                                                            Value="#16A34A"/>

                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
