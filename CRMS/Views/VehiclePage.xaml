<Page x:Class="CRMS.Views.VehiclePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:CRMS.ViewModels" Title="Đội xe">
    <Page.DataContext>
        <vm:VehicleViewModel />
    </Page.DataContext>
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24">
            <Button DockPanel.Dock="Right" Content="↻  Làm mới" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Danh sách xe" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Theo dõi đội xe, giá thuê và trạng thái hoạt động." Style="{StaticResource Subtitle}" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ XE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalVehicles}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,2" />
                    <TextBlock Text="Xe trong hệ thống" Style="{StaticResource Subtitle}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="KẾT QUẢ HIỂN THỊ" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FilteredCount}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,7,0,2" />
                    <TextBlock Text="Phù hợp với bộ lọc" Style="{StaticResource Subtitle}" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#EAF1FF" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock Text="TRA CỨU ĐỘI XE" Foreground="#2563EB" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="Tìm xe phù hợp" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,8" />
                    <TextBlock Text="Tìm theo biển số, hãng hoặc mẫu xe. Lọc theo trạng thái hoạt động." Style="{StaticResource Subtitle}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Tìm kiếm xe" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <TextBox Height="40" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tìm kiếm xe" />
                    <TextBlock Text="Nhập biển số, hãng hoặc mẫu xe…" Margin="14,0" Foreground="#8B97AA" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Trạng thái xe" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Height="40" AutomationProperties.Name="Trạng thái xe"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource VietnameseLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid Margin="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="18,15">
                    <TextBlock Text="Tất cả xe" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Nhấn tiêu đề cột để sắp xếp" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding VehiclesView}" AutomationProperties.Name="Danh sách xe">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BIỂN SỐ" Binding="{Binding LicensePlate}" Width="125" />
                        <DataGridTemplateColumn Header="XE" SortMemberPath="Brand" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Brand}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Model}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="NĂM" Binding="{Binding ManufactureYear}" Width="72" />
                        <DataGridTextColumn Header="SỐ CHỖ" Binding="{Binding SeatCount}" Width="72" />
                        <DataGridTextColumn Header="HỘP SỐ" Binding="{Binding Transmission, Converter={StaticResource VietnameseLabel}}" Width="125" />
                        <DataGridTextColumn Header="GIÁ/NGÀY · VNĐ" Binding="{Binding DailyRate, StringFormat={}{0:N0}}" Width="145" />
                        <DataGridTemplateColumn Header="TRẠNG THÁI" SortMemberPath="OperationalStatus" Width="155">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EDF2FA" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding OperationalStatus, Converter={StaticResource VietnameseLabel}}" Foreground="#425C80" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Margin="0,44,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Chưa có xe để hiển thị" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Điều chỉnh bộ lọc hoặc làm mới danh sách xe." Style="{StaticResource Subtitle}" Margin="0,8,0,0" />
                </StackPanel>
                <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" BorderThickness="0" Foreground="{StaticResource Accent}" />
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource Subtitle}" FontSize="11" Margin="2,12,0,0" />
    </Grid>
</Page>
